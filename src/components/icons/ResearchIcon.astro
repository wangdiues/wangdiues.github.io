---
// Minimal line icons matching the stroke language already used for the
// theme-toggle sun/moon icons in Nav.astro (18-20px, ~1.6 stroke-width).
// No icon-library dependency.
interface Props {
  name: 'wildlife' | 'camtrap' | 'forest' | 'climate' | 'ecosystem' | 'education';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

{
  name === 'wildlife' && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <ellipse cx="12" cy="16.5" rx="5" ry="4" stroke="currentColor" stroke-width="1.6" />
      <ellipse cx="5.5" cy="10" rx="2" ry="2.4" stroke="currentColor" stroke-width="1.6" />
      <ellipse cx="18.5" cy="10" rx="2" ry="2.4" stroke="currentColor" stroke-width="1.6" />
      <ellipse cx="9" cy="5.5" rx="1.8" ry="2.2" stroke="currentColor" stroke-width="1.6" />
      <ellipse cx="15" cy="5.5" rx="1.8" ry="2.2" stroke="currentColor" stroke-width="1.6" />
    </svg>
  )
}
{
  name === 'camtrap' && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <rect x="3.5" y="7" width="17" height="12" rx="2" stroke="currentColor" stroke-width="1.6" />
      <circle cx="12" cy="13" r="3.4" stroke="currentColor" stroke-width="1.6" />
      <path d="M8 7l1.4-2.4h5.2L16 7M6.5 10.5h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'forest' && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path
        d="M12 3 6 11h3.2L5 18h14l-4.2-7H18L12 3Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <path d="M12 18v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'climate' && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path
        d="M7.5 16h9a3.5 3.5 0 0 0 0-7 5 5 0 0 0-9.6-1.6A3.5 3.5 0 0 0 7.5 16Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <path d="M9 19h.01M12 20h.01M15 19h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'ecosystem' && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path
        d="M12 3.5 19 6.5v5c0 5-3 8.2-7 9-4-.8-7-4-7-9v-5L12 3.5Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <path d="m9 12 2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'education' && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path
        d="M2.5 9 12 5l9.5 4-9.5 4-9.5-4Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <path d="M6 11v4.5c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5V11M21.5 9v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
