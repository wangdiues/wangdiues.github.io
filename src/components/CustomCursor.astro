---
// Trailing multi-ring cursor, adapted from princepal.in's mechanism (a lead
// ring plus several lagging rings tracing the pointer) into this site's own
// warm ember/amber gradient rather than his teal/gold. Only activates for
// fine-pointer devices with no reduced-motion preference — everyone else
// keeps the native cursor, and nothing here ever blocks a click or a
// keyboard interaction (every ring is aria-hidden and pointer-events: none).
const RING_COUNT = 6;
---

<div id="cursor-rings" aria-hidden="true">
  {
    Array.from({ length: RING_COUNT }).map((_, i) => (
      <span class:list={['cursor-ring', i === 0 && 'cursor-ring--lead']} data-ring={i}>
        <svg viewBox="0 0 32 32">
          <circle cx="16" cy="16" r="14" />
        </svg>
      </span>
    ))
  }
  <svg width="0" height="0" style="position:absolute">
    <defs>
      <linearGradient id="cursorRingGradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--color-amber-500)" />
        <stop offset="0.55" stop-color="var(--color-ember-500)" />
        <stop offset="1" stop-color="var(--color-ember-300)" />
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
  #cursor-rings {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 2000;
  }

  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    pointer-events: none;
    opacity: 0;
    will-change: transform, opacity;
  }

  .cursor-ring svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cursor-ring circle {
    fill: none;
    stroke: url('#cursorRingGradient');
    stroke-width: 2.5;
  }

  .cursor-ring--lead circle {
    stroke-width: 3;
  }

  body.has-custom-cursor,
  body.has-custom-cursor a,
  body.has-custom-cursor button,
  body.has-custom-cursor [data-work-item] {
    cursor: none;
  }
</style>

<script>
  const root = document.getElementById('cursor-rings');
  const rings = root ? [...root.querySelectorAll<HTMLElement>('.cursor-ring')] : [];
  const finePointer = matchMedia('(pointer: fine)').matches;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && rings.length > 0 && finePointer && !reducedMotion) {
    document.body.classList.add('has-custom-cursor');

    const positions = rings.map(() => ({ x: innerWidth / 2, y: innerHeight / 2 }));
    let target = { x: positions[0].x, y: positions[0].y };
    let active = false;
    let hovering = false;

    window.addEventListener(
      'pointermove',
      (event) => {
        target = { x: event.clientX, y: event.clientY };
        if (!active) {
          active = true;
          rings.forEach((ring) => ring.style.setProperty('opacity', '1'));
        }
      },
      { passive: true }
    );

    window.addEventListener('pointerleave', () => {
      rings.forEach((ring) => (ring.style.opacity = '0'));
      active = false;
    });

    const interactiveSelector = 'a, button, [data-work-item], summary, input, textarea, select';
    document.addEventListener(
      'pointerover',
      (event) => {
        hovering = Boolean((event.target as HTMLElement)?.closest?.(interactiveSelector));
      },
      { passive: true }
    );

    function frame() {
      let x = target.x;
      let y = target.y;
      for (let i = 0; i < rings.length; i++) {
        const pos = positions[i];
        const ease = i === 0 ? 0.35 : 0.28;
        pos.x += (x - pos.x) * ease;
        pos.y += (y - pos.y) * ease;
        const scale = i === 0 && hovering ? 1.6 : 1;
        rings[i].style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0) scale(${scale})`;
        x = pos.x;
        y = pos.y;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
</script>
