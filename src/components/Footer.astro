---
import { SOCIAL } from '../config';
---

<footer class="dark-section bg-ink-950 py-10">
  <div class="site-shell grid gap-8 sm:grid-cols-[1.3fr_0.7fr] sm:items-end">
    <div>
      <a href="/" class="font-heading text-2xl font-semibold tracking-tight text-paper-50">Wangdi</a>
      <p class="mt-2 max-w-lg text-sm text-[var(--color-text-muted)]">
        Biodiversity science, spatial ecology, and public forest governance from Bhutan.
      </p>
      <p class="mt-5 text-xs tracking-wider text-[var(--color-text-muted)] uppercase">
        © {new Date().getFullYear()} · Built for evidence, access, and conservation action
      </p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm sm:justify-end" aria-label="Social links">
      {
        SOCIAL.map((s) => (
          <li>
            <a
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="link-arrow text-[var(--color-text-muted)] hover:text-ember-300"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
