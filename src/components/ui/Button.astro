---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md';
  external?: boolean;
  download?: boolean | string;
  class?: string;
}

const { href, variant = 'primary', size = 'md', external = false, download, class: className = '' } = Astro.props;

const base = 'inline-flex min-h-11 items-center justify-center gap-2 rounded-full border font-semibold transition duration-200 active:scale-[0.98]';
const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-2.5 text-sm sm:text-base',
} as const;
const variants = {
  primary: 'border-[var(--color-accent-solid)] bg-[var(--color-accent-solid)] text-[var(--color-on-accent-solid)] hover:border-[var(--color-accent-hover)] hover:bg-[var(--color-accent-hover)] hover:text-[var(--color-bg-base)]',
  secondary: 'border-[var(--color-text-primary)] bg-transparent text-[var(--color-text-primary)] hover:bg-[var(--color-accent-solid)] hover:text-ink-950',
  ghost: 'border-transparent px-2 text-[var(--color-text-muted)] underline-offset-4 hover:text-[var(--color-text-primary)] hover:underline',
} as const;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download}
  class:list={[base, sizes[size], variants[variant], className]}
>
  <slot />
</a>
