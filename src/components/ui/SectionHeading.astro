---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<div class="max-w-prose">
  <p class="mb-2 text-sm font-medium tracking-widest text-moss-400 uppercase">{eyebrow}</p>
  <h2 class="text-h2 text-paper-50">{title}</h2>
  {lede && <p class="mt-3 text-lead text-[var(--color-text-muted)]">{lede}</p>}
</div>
