---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'glass-panel glass-panel-hover group relative block overflow-hidden rounded-[var(--radius-lg)] p-6 sm:p-7',
    className,
  ]}
>
  <slot />
</Tag>
