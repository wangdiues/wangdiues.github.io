---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'group relative block overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)]/78 p-6 shadow-card transition duration-200 before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-gradient-to-r before:from-transparent before:via-moss-400/45 before:to-transparent hover:-translate-y-1 hover:border-moss-400/55 hover:bg-[var(--color-bg-raised)] sm:p-7',
    className,
  ]}
>
  <slot />
</Tag>
