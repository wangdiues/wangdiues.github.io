---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'group relative block overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)] p-6 transition duration-200 hover:border-[var(--color-text-primary)] hover:bg-[var(--color-accent-solid)] sm:p-7',
    className,
  ]}
>
  <slot />
</Tag>
