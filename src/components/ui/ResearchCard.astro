---
import ResearchIcon from '../icons/ResearchIcon.astro';
import TagPill from './TagPill.astro';

interface Props {
  icon: 'wildlife' | 'camtrap' | 'forest' | 'climate' | 'ecosystem' | 'education';
  name: string;
  description: string;
  tags: string[];
  href: string;
}

const { icon, name, description, tags, href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex h-full flex-col gap-4 rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)] p-6 transition duration-200 hover:-translate-y-0.5 hover:border-[var(--color-accent)] focus-visible:-translate-y-0.5 focus-visible:border-[var(--color-accent)]"
>
  <ResearchIcon
    name={icon}
    class="h-8 w-8 text-[var(--color-text-muted)] transition-colors duration-200 group-hover:text-[var(--color-accent)] group-focus-visible:text-[var(--color-accent)]"
  />
  <div>
    <p class="flex items-center gap-1.5 font-heading text-lg leading-snug text-[var(--color-text-primary)]">
      {name}
      <span
        aria-hidden="true"
        class="inline-block translate-x-0 opacity-0 transition duration-200 group-hover:translate-x-0.5 group-hover:opacity-100 group-focus-visible:translate-x-0.5 group-focus-visible:opacity-100"
        >↗</span
      >
    </p>
    <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{description}</p>
  </div>
  {
    tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-2 border-t border-[var(--color-border-subtle)] pt-4">
        {tags.map((tag) => (
          <TagPill label={tag} />
        ))}
      </div>
    )
  }
  <span class="sr-only">View repository on GitHub (opens in a new tab)</span>
</a>
