---
interface Props {
  status: 'published' | 'under-review' | 'in-preparation' | 'report';
  label?: string;
}

const { status, label } = Astro.props;

const styles: Record<Props['status'], string> = {
  published: 'border-nvidia-green-500/30 bg-nvidia-green-500/15 font-semibold text-nvidia-green-400',
  'under-review': 'border-tag-blue-500/45 bg-tag-blue-500/10 text-tag-blue-400',
  'in-preparation': 'border-tag-purple-500/45 bg-tag-purple-500/10 text-tag-purple-400',
  report: 'border-[var(--color-text-primary)]/30 bg-transparent text-[var(--color-text-primary)]',
};

const labels: Record<Props['status'], string> = {
  published: 'Published',
  'under-review': 'Under review',
  'in-preparation': 'In preparation',
  report: 'Report',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full border px-3 py-1.5 text-[0.68rem] font-medium tracking-[0.14em] uppercase',
    styles[status],
  ]}
>
  {label ?? labels[status]}
</span>
