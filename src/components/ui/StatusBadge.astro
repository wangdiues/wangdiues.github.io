---
interface Props {
  status: 'published' | 'under-review' | 'in-preparation' | 'report';
  label?: string;
}

const { status, label } = Astro.props;

const styles: Record<Props['status'], string> = {
  published: 'border-transparent bg-moss-500 font-semibold text-ink-900',
  'under-review': 'border-amber-500 text-amber-500',
  'in-preparation': 'border-slate-400 text-slate-400',
  report: 'border-paper-50/40 text-paper-50',
};

const labels: Record<Props['status'], string> = {
  published: 'Published',
  'under-review': 'Under review',
  'in-preparation': 'In preparation',
  report: 'Report',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full border px-3 py-1 text-xs tracking-wider uppercase',
    styles[status],
  ]}
>
  {label ?? labels[status]}
</span>
