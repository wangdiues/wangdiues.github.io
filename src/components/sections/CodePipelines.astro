---
import SectionHeading from '../ui/SectionHeading.astro';
import ResearchCard from '../ui/ResearchCard.astro';
import ResearchIcon from '../icons/ResearchIcon.astro';
import TagPill from '../ui/TagPill.astro';
import { GITHUB_PROFILE } from '../../config';
import { RESEARCH_DOMAINS, TECH_ECOSYSTEM, domainRepos } from '../../data/research-domains';

const domainsWithRepos = RESEARCH_DOMAINS.map((domain) => ({
  domain,
  repos: domainRepos(domain),
}));

const allRepos = domainsWithRepos.flatMap((d) => d.repos);

// Every number below is computed from research-domains.ts / config.ts at
// build time — none are hardcoded.
const frameworkTags = new Set(
  allRepos.flatMap((repo) => repo.tags.filter((tag) => tag !== repo.language))
);
const platformLanguages = new Set(allRepos.map((repo) => repo.language).filter(Boolean));

const stats = [
  { value: String(allRepos.length), label: 'Open-source repositories' },
  { value: String(RESEARCH_DOMAINS.length), label: 'Research domains' },
  { value: String(frameworkTags.size), label: 'Analytical frameworks' },
  { value: String(platformLanguages.size), label: 'Programming platforms' },
];
---

<section id="code" class="section-space scroll-mt-24" aria-label="Open science and reproducible research">
  <div class="site-shell">
    <SectionHeading eyebrow="Open science" title="Open Science & Reproducible Research" />
    <p class="mt-5 max-w-2xl text-[var(--color-text-muted)]">
      Analytical workflows supporting ecological assessments, publications, and conservation decisions.
      All pipelines are developed using open-source tools to promote transparency, reproducibility, and
      collaboration.
      <a
        href={GITHUB_PROFILE}
        target="_blank"
        rel="noopener noreferrer"
        class="link-arrow text-[var(--color-accent)] underline-offset-4 hover:underline">Browse everything on GitHub</a
      >.
    </p>

    <div class="mt-10 grid grid-cols-2 border-l border-t border-[var(--color-border-subtle)] lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="border-b border-r border-[var(--color-border-subtle)] p-5 sm:p-6">
            <p class="font-heading text-4xl font-medium tracking-[-0.03em] text-[var(--color-accent)] tabular-nums sm:text-5xl">
              {stat.value}
            </p>
            <p class="mt-2 text-xs leading-snug text-[var(--color-text-muted)] sm:text-sm">{stat.label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 space-y-14">
      {
        domainsWithRepos.map(({ domain, repos }) =>
          repos.length > 0 && (
            <div>
              <div class="flex items-start gap-4">
                <ResearchIcon name={domain.icon} class="mt-1 h-7 w-7 shrink-0 text-[var(--color-accent)]" />
                <div>
                  <h3 class="font-heading text-xl text-[var(--color-text-primary)] sm:text-2xl">{domain.title}</h3>
                  <p class="mt-1 max-w-2xl text-sm text-[var(--color-text-muted)]">{domain.blurb}</p>
                </div>
              </div>
              <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {repos.map((repo) => (
                  <ResearchCard
                    icon={domain.icon}
                    name={repo.name}
                    description={repo.description}
                    tags={repo.tags}
                    href={repo.href}
                  />
                ))}
              </div>
            </div>
          )
        )
      }
    </div>

    <div class="mt-16 border-t border-[var(--color-border-subtle)] pt-10">
      <p class="text-xs font-semibold tracking-[0.2em] text-[var(--color-text-muted)] uppercase">Technology ecosystem</p>
      <div class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {
          TECH_ECOSYSTEM.map((group) => (
            <div>
              <p class="text-sm font-medium text-[var(--color-text-primary)]">{group.label}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <TagPill label={item} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
