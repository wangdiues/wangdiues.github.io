---
import { getCollection, render } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import StatusBadge from '../ui/StatusBadge.astro';

const resolvedJobs = await Promise.all(
  (await getCollection('experience'))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map(async (job) => ({ job, Content: (await render(job)).Content }))
);
---

<section id="experience" class="scroll-mt-20 border-y border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)]/40 py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading
      eyebrow="Experience"
      title="Forest governance, biodiversity monitoring, and climate planning."
    />
    <ol class="mt-12 space-y-10 border-l border-[var(--color-border-subtle)] pl-8">
      {
        resolvedJobs.map(({ job, Content }) => (
          <li class="relative">
            <span class="absolute -left-[41px] top-1.5 h-3 w-3 rounded-full border-2 border-moss-400 bg-[var(--color-bg-base)]" aria-hidden="true" />
            <div class="flex flex-wrap items-center gap-3">
              <p class="text-sm text-[var(--color-text-muted)]">{job.data.range}</p>
              {job.data.range.includes('Present') && <StatusBadge status="published" label="Current" />}
            </div>
            <h3 class="mt-2 text-h3 text-paper-50">{job.data.title}</h3>
            <p class="mt-1 text-sm text-moss-400">{job.data.location}</p>
            <div class="mt-4 max-w-none text-[var(--color-text-muted)] [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-2">
              <Content />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
