---
import { getCollection, render } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import StatusBadge from '../ui/StatusBadge.astro';

const resolvedJobs = await Promise.all(
  (await getCollection('experience'))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map(async (job) => ({ job, Content: (await render(job)).Content }))
);
---

<section id="experience" class="dark-section section-space scroll-mt-24 bg-ink-950">
  <div class="site-shell">
    <SectionHeading
      eyebrow="Experience"
      title="Forest governance, biodiversity monitoring, and climate planning."
    />
    <ol class="mt-14 border-t border-[var(--color-border-subtle)]">
      {
        resolvedJobs.map(({ job, Content }, index) => (
          <li class="grid gap-5 border-b border-[var(--color-border-subtle)] py-8 md:grid-cols-[10rem_1fr] md:gap-10 lg:grid-cols-[13rem_1fr]">
            <div>
              <span class="text-[0.65rem] font-semibold tracking-[0.18em] text-ember-400" aria-hidden="true">0{index + 1}</span>
              <p class="text-sm text-[var(--color-text-muted)]">{job.data.range}</p>
              {job.data.range.includes('Present') && <div class="mt-3"><StatusBadge status="published" label="Current" /></div>}
            </div>
            <div>
              <h3 class="text-h3 text-paper-50">{job.data.title}</h3>
              <p class="mt-2 text-sm font-medium text-ember-400">{job.data.location}</p>
              <div class="mt-5 max-w-3xl text-[var(--color-text-muted)] [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5">
                <Content />
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
