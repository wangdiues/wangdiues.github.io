---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import TagPill from '../ui/TagPill.astro';
import portrait from '../../assets/wangdi-profile-cutout-hd.png';

const heroVideo = {
  mp4: '/video/hero/misty-sunrise.mp4',
  webm: '/video/hero/misty-sunrise.webm',
  poster: '/video/hero/misty-sunrise-poster.jpg',
};
---

<section class="hero relative isolate overflow-hidden pb-10 pt-32 sm:pt-36 lg:pb-14 lg:pt-44">
  <div class="hero-media" aria-hidden="true" style={`--hero-poster-image: url('${heroVideo.poster}')`}>
    <video class="hero-media-video" autoplay muted loop playsinline preload="auto" poster={heroVideo.poster}>
      <source src={heroVideo.webm} type="video/webm" />
      <source src={heroVideo.mp4} type="video/mp4" />
    </video>
  </div>

  <div class="site-shell">
    <div class="hero-enter">
      <div class="hero-top grid gap-4 lg:grid-cols-[1.55fr_0.6fr] lg:items-stretch">
        <div class="hero-headline lg:flex lg:h-full lg:flex-col">
          <p class="eyebrow badge-label glass-panel glass-panel-sm inline-flex rounded-full px-4 py-2">
            <span class="h-px w-8 bg-current" aria-hidden="true"></span>
            Senior Forestry Officer
          </p>

          <h1 class="hero-title mt-5 font-heading text-[clamp(3.6rem,2rem+7vw,7.75rem)] leading-[0.92] tracking-[-0.06em]">
            Wangdi
          </h1>

          <p class="hero-subtitle mt-4 font-heading font-bold text-[clamp(1.4rem,1.1rem+1.1vw,2.1rem)] leading-snug text-[var(--color-text-primary)]/90 lg:whitespace-nowrap lg:text-[1.35rem] xl:text-[1.6rem]">
            Biodiversity, Climate &amp; Forest Governance
          </p>

          <div class="profile-card mt-4 lg:flex-1">
            <ul class="flex flex-wrap gap-2" aria-label="Professional specializations">
              <li class="hero-chip">Community-Based NWFP Management</li>
              <li class="hero-chip">Forest Bioeconomy</li>
              <li class="hero-chip">Rural Livelihoods</li>
              <li class="hero-chip">GIS</li>
              <li class="hero-chip">Remote Sensing</li>
              <li class="hero-chip">Ecological Modelling</li>
              <li class="hero-chip">Conservation Research</li>
            </ul>

            <ul class="mt-4 flex flex-wrap gap-2">
              <li class="min-w-56 flex-1">
                <a
                  href="https://www.conservationleadershipprogramme.org/project/bhutans-first-gps-ai-study-great-hornbills/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hero-award-badge"
                >
                  2026 CLP Future Conservationist Team Award Winner
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
              <li class="min-w-56 flex-1">
                <span class="hero-award-badge hero-award-badge-static">
                  Meritorious Promotion · RCSC 2026
                </span>
              </li>
            </ul>

            <div class="hero-contact-row mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm">
              <span class="hero-heading font-semibold">Department of Forests &amp; Park Services</span>
              <span class="hero-contact-sep" aria-hidden="true">·</span>
              <nav aria-label="Professional contact links">
                <ul class="flex flex-wrap gap-x-3">
                  <li><a href="mailto:wangdiues@gmail.com" class="hero-link">wangdiues@gmail.com</a></li>
                  <li><a href="https://www.linkedin.com/in/wangdiues/" target="_blank" rel="noopener noreferrer" class="hero-link">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a></li>
                  <li><a href="https://www.researchgate.net/profile/Wangdi-Wangdi-3" target="_blank" rel="noopener noreferrer" class="hero-link">ResearchGate<span class="sr-only"> (opens in a new tab)</span></a></li>
                </ul>
              </nav>
            </div>
          </div>
        </div>

        <figure class="hero-portrait-frame">
          <Image
            src={portrait}
            alt="Portrait of Wangdi"
            widths={[440, 640, 880, 1100]}
            sizes="(min-width: 1024px) 44vw, 100vw"
            class="hero-portrait"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>

      <div class="hero-bio-card mt-6">
        <p class="section-subtitle">Professional Profile</p>
        <p class="hero-body-text mt-4 text-base sm:text-lg">
          Public-sector forestry, biodiversity, and environmental management professional with five years of progressive experience in Bhutan's forest governance system. Currently serving as Senior Forestry Officer in the NWFP Section, Forest Resources Planning &amp; Management Division, following a merit-based promotion within the first four years of service. Expertise spans biodiversity conservation, climate-responsive forest management, NWFP governance, GIS and remote sensing, ecological research, and policy-linked environmental planning. Team Leader and recipient of the 2026 Conservation Leadership Programme (CLP) Future Conservationist Team Award for Connected Skies: Bhutan's First GPS-AI Study Empowering Communities to Protect Great Hornbills. Also appointed as an Adjunct Lecturer at the College of Natural Resources, Royal University of Bhutan, to deliver Forest Mensuration (MEN201).
        </p>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <TagPill label="Forest governance" />
        <TagPill label="Spatial ecology" />
        <TagPill label="Climate resilience" />
        <Button href="/#work">View selected work</Button>
        <Button href="/Wangdi_CV_2026.pdf" variant="secondary" external>View CV ↗</Button>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* is:global — TagPill/Button are child components with their own Astro
     scope hash, so a normally-scoped selector here couldn't reach the glass
     panel they render internally (see the .hero .glass-panel rule below).
     Every rule stays qualified by .hero or a hero-specific class name (none
     of which exist elsewhere — verified) so nothing leaks to other sections.

     Hero-scoped video layer. `isolate` on the section keeps this local so it
     never competes with the page-wide fixed background (VideoBackground)
     used by every other section, or the nav. The clip itself is shown at
     full, unfiltered quality — no brightness/contrast/saturate/blur, no
     darkening overlay. Any blur below belongs to the small glass UI panels
     sitting on top of it, never to the video layer itself. */
  .hero .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero .hero-media-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero .hero-media-video {
      display: none;
    }

    .hero .hero-media {
      background: center / cover no-repeat;
      background-image: var(--hero-poster-image);
    }
  }

  /* PORTRAIT — a large, self-contained glass frame. Below lg it's a single
     grid item in its own row, so `height: 100%` has no determinate track to
     stretch against and collapses to the image's raw (very tall) intrinsic
     ratio — a fixed aspect-ratio keeps it a sane, determinate size there.
     At lg+ it shares a row with the headline (see the media query below),
     where stretch legitimately fills most of the right-hand hero region
     instead of floating as a small card. object-fit: cover on the image
     crops to fill without stretching the subject; object-position keeps
     the head/shoulders framed. */
  .hero .hero-portrait-frame {
    display: block;
    width: 100%;
    max-width: 15rem;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 12px 40px rgba(0, 0, 0, 0.35);
    border-radius: 20px;
    padding: 0.75rem;
  }

  @media (min-width: 1024px) {
    .hero .hero-portrait-frame {
      /* Fills its entire grid column — flush against the card on the left
         (only the grid gap between them, no extra empty margin) and flush
         against the site-shell's right edge (no trailing empty space
         either). Stretches to match the headline column's height, as
         before. */
      max-width: none;
      width: 100%;
      margin-inline: 0;
      aspect-ratio: auto;
      height: 100%;
      min-height: clamp(12rem, 20vw, 16rem);
    }
  }

  .hero .hero-portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    border-radius: 14px;
  }

  /* PROFILE CARD — a plain full-width block (not sharing a grid column with
     the portrait any more), so it uses the whole site-shell content width
     instead of a constrained left column. Holds the scannable facts: chips,
     award badges, and the contact row. */
  .hero .profile-card {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 1.5rem;
  }

  /* Specialization chips — small glass pills matching the TagPill language
     used elsewhere on the page, instead of a dot-separated run-on line. */
  .hero .hero-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 500;
    color: #f7f3ea;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  /* Award badges — compact pills instead of two stacked, divider-separated
     list items. */
  .hero .hero-award-badge {
    display: flex;
    align-items: center;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    padding: 0.5rem 0.9rem;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.35;
    white-space: normal;
    text-align: left;
    color: var(--color-accent-gold);
    background: color-mix(in srgb, var(--color-accent-gold) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-gold) 35%, transparent);
    transition: color 0.2s ease, background 0.2s ease;
  }

  a.hero-award-badge:hover {
    color: var(--color-accent-gold-hover);
    background: color-mix(in srgb, var(--color-accent-gold) 20%, transparent);
  }

  .hero .hero-award-badge-static {
    color: #f7f3ea;
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.16);
  }

  .hero .hero-contact-sep {
    color: var(--color-accent-gold);
  }

  /* 3a. Accent/badge text — warm golden-yellow, used selectively (labels,
     links, separators), never for full paragraphs. */
  .hero .badge-label,
  .hero .section-subtitle {
    color: var(--color-accent-gold);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* 3b. Headings — bright white; Wangdi and its subtitle are golden instead,
     as the strongest, most prominent register. */
  .hero .hero-heading {
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
  }

  /* Gold accents pull from the site's shared --color-accent-gold* tokens
     (tokens.css) instead of a Hero-local hardcoded palette, so the Hero's
     gold matches the rest of the site exactly. Title uses the darker/muted
     -solid step, subtitle the brighter default step, preserving their
     original relative contrast. */
  .hero .hero-title {
    color: var(--color-accent-gold-solid);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
  }

  /* 3c. Body text — warm off-white, not dark/muted grey. */
  .hero .profile-card p,
  .hero .profile-card li,
  .hero .hero-bio-card p,
  .hero .hero-body-text {
    color: #f7f3ea;
    line-height: 1.6;
  }

  /* BIO CARD — same warm-glass language as .profile-card but lighter and
     less opaque, so the long-form paragraph reads as its own "read this for
     depth" tier rather than more of the scannable card above it. Runs the
     full site-shell width, below both the headline and the portrait. */
  .hero .hero-bio-card {
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.75rem 2rem;
  }

  /* 3d. Links — gold, brightening on hover. */
  .hero .hero-link {
    color: var(--color-accent-gold);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .hero .hero-link:hover {
    color: var(--color-accent-gold-hover);
  }

  /* The small eyebrow pill and tag pills still sit directly on the
     unfiltered video (outside the now-opaque profile-card), so they keep
     the text-shadow that lifts them off the brightest parts of the clip. */
  .hero .glass-panel {
    text-shadow:
      0 1px 3px rgba(0, 0, 0, 0.85),
      0 1px 14px rgba(0, 0, 0, 0.6);
  }

  .hero .hero-subtitle {
    color: var(--color-accent-gold);
    text-shadow:
      0 1px 14px rgba(0, 0, 0, 0.45),
      0 1px 3px rgba(0, 0, 0, 0.6);
  }
</style>

<script>
  const heroVideos = document.querySelectorAll<HTMLVideoElement>('.hero-media-video');

  document.addEventListener('visibilitychange', () => {
    for (const video of heroVideos) {
      if (document.hidden) {
        video.pause();
      } else {
        video.play().catch(() => {});
      }
    }
  });
</script>
