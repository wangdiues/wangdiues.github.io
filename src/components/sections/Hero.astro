---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import TagPill from '../ui/TagPill.astro';
import portrait from '../../assets/wangdi-profile.jpg';
---

<section class="relative overflow-hidden pb-16 pt-32 sm:pt-36 lg:pb-24 lg:pt-40">
  <div class="site-shell">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.18fr)_minmax(20rem,0.62fr)] lg:items-start lg:gap-16">
      <div class="hero-enter">
        <p class="text-xs font-semibold tracking-[0.18em] text-[var(--color-accent)] uppercase">
          Senior Forestry Officer
        </p>
        <h1 class="mt-3 font-heading text-[clamp(4rem,2.2rem+7vw,8rem)] leading-[0.9] tracking-[-0.065em] text-[var(--color-text-primary)] uppercase">
          Wangdi
        </h1>
        <p class="mt-5 max-w-2xl font-heading text-[clamp(1.45rem,1.1rem+1.25vw,2.15rem)] leading-snug text-[var(--color-text-primary)]">
          Biodiversity, Climate &amp; Forest Governance
        </p>

        <ul class="mt-6 flex max-w-3xl flex-wrap gap-x-3 gap-y-2 text-sm leading-relaxed text-[var(--color-text-muted)]" aria-label="Professional specializations">
          <li>Community-Based NWFP Management</li>
          <li aria-hidden="true">·</li>
          <li>Forest Bioeconomy</li>
          <li aria-hidden="true">·</li>
          <li>Rural Livelihoods</li>
          <li aria-hidden="true">·</li>
          <li>GIS</li>
          <li aria-hidden="true">·</li>
          <li>Remote Sensing</li>
          <li aria-hidden="true">·</li>
          <li>Ecological Modelling</li>
          <li aria-hidden="true">·</li>
          <li>Conservation Research</li>
        </ul>

        <ul class="mt-8 max-w-3xl border-y border-[var(--color-border-subtle)] text-sm">
          <li class="py-4">
            <a
              href="https://www.conservationleadershipprogramme.org/project/bhutans-first-gps-ai-study-great-hornbills/"
              target="_blank"
              rel="noopener noreferrer"
              class="link-arrow font-semibold text-[var(--color-text-primary)] hover:text-[var(--color-accent)]"
            >
              2026 CLP Future Conservationist Team Award Winner
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
          <li class="border-t border-[var(--color-border-subtle)] py-4 text-[var(--color-text-muted)]">
            <strong class="font-semibold text-[var(--color-text-primary)]">Meritorious Promotion</strong>, Royal Civil Service Commission · 2026
          </li>
        </ul>

        <p class="mt-7 text-sm font-semibold text-[var(--color-text-primary)]">
          Department of Forests &amp; Park Services
        </p>
        <nav class="mt-3" aria-label="Professional contact links">
          <ul class="flex flex-wrap divide-x divide-[var(--color-border-subtle)] text-sm">
            <li class="pr-3">
              <a href="mailto:wangdiues@gmail.com" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)]">wangdiues@gmail.com</a>
            </li>
            <li class="px-3">
              <a href="https://www.linkedin.com/in/wangdiues/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)]">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
            </li>
            <li class="pl-3">
              <a href="https://www.researchgate.net/profile/Wangdi-Wangdi-3" target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)]">ResearchGate<span class="sr-only"> (opens in a new tab)</span></a>
            </li>
          </ul>
        </nav>

        <div class="mt-10 max-w-3xl border-t border-[var(--color-text-primary)] pt-7">
          <h2 class="text-xs font-semibold tracking-[0.18em] text-[var(--color-accent)] uppercase">
            Professional Profile
          </h2>
          <p class="mt-4 text-base leading-relaxed text-[var(--color-text-muted)] sm:text-lg">
            Public-sector forestry, biodiversity, and environmental management professional with five years of progressive experience in Bhutan's forest governance system. Currently serving as Senior Forestry Officer in the NWFP Section, Forest Resources Planning &amp; Management Division, following a merit-based promotion within the first four years of service. Expertise spans biodiversity conservation, climate-responsive forest management, NWFP governance, GIS and remote sensing, ecological research, and policy-linked environmental planning. Team Leader and recipient of the 2026 Conservation Leadership Programme (CLP) Future Conservationist Team Award for Connected Skies: Bhutan's First GPS-AI Study Empowering Communities to Protect Great Hornbills. Also appointed as an Adjunct Lecturer at the College of Natural Resources, Royal University of Bhutan, to deliver Forest Mensuration (MEN201).
          </p>
        </div>

        <div class="mt-7 flex flex-wrap gap-2" aria-label="Areas of practice">
          <TagPill label="Forest governance" />
          <TagPill label="Spatial ecology" />
          <TagPill label="Climate resilience" />
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/#work">View selected work</Button>
          <Button href="/Wangdi_CV_2026.pdf" variant="secondary" external>View CV ↗</Button>
        </div>
      </div>

      <figure class="hero-enter hero-enter-delay relative mx-auto w-full max-w-[32rem] overflow-hidden rounded-[var(--radius-lg)] bg-[var(--color-bg-raised)]">
        <Image
          src={portrait}
          alt="Portrait of Wangdi"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 32rem, 100vw"
          class="aspect-[3/4] h-full w-full object-cover object-top"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </div>
</section>
