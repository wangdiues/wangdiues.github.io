---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import TagPill from '../ui/TagPill.astro';
import profile from '../../assets/profile.jpg';
---

<section class="relative overflow-hidden pt-32 pb-20">
  <div
    class="pointer-events-none absolute -top-40 right-[-10%] h-[480px] w-[480px] rounded-full opacity-25"
    style="background: radial-gradient(closest-side, var(--color-moss-500), transparent)"
    aria-hidden="true"
  >
  </div>
  <div class="mx-auto grid max-w-5xl items-center gap-12 px-6 lg:grid-cols-[1.2fr_0.8fr]">
    <div>
      <p class="mb-4 text-sm font-medium tracking-widest text-moss-400 uppercase">
        Research · conservation · public forest governance
      </p>
      <h1 class="text-display leading-tight text-paper-50">Wangdi Wangdi</h1>
      <p class="mt-6 max-w-xl text-lead text-[var(--color-text-muted)]">
        I am a Senior Forestry Officer and conservation researcher translating ecological evidence
        into biodiversity, climate resilience, and sustainable forest management decisions across Bhutan.
      </p>
      <p class="mt-4 text-sm text-[var(--color-text-muted)]">
        Team Leader ·
        <a
          href="https://www.conservationleadershipprogramme.org/project/bhutans-first-gps-ai-study-great-hornbills/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-moss-400 underline-offset-4 hover:underline">2026 CLP Future Conservationist Team Award</a
        > — <em>Connected Skies</em>, Bhutan's first GPS-AI Great Hornbill study
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <TagPill label="Bhutan forest governance" />
        <TagPill label="Spatial ecology" />
        <TagPill label="Climate resilience" />
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="/Wangdi_CV_2026.pdf" external>View CV</Button>
        <Button href="/#work" variant="secondary">Explore work</Button>
      </div>
    </div>
    <div class="mx-auto w-full max-w-xs">
      <Image
        src={profile}
        alt="Portrait of Wangdi Wangdi"
        widths={[320, 480]}
        sizes="(min-width: 1024px) 320px, 80vw"
        class="rounded-lg border border-[var(--color-border-subtle)] shadow-card"
        loading="eager"
      />
    </div>
  </div>
</section>
