---
import SectionHeading from '../ui/SectionHeading.astro';
import { SOCIAL } from '../../config';
---

<section id="contact" class="section-space scroll-mt-24 border-t border-[var(--color-border-subtle)]">
  <div class="dark-section site-shell grid overflow-hidden rounded-[var(--radius-lg)] bg-ink-950 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="p-7 sm:p-10 lg:p-12">
      <SectionHeading
        eyebrow="Contact"
        title="Open to research collaboration, conservation planning, and technical exchange."
      />
      <p class="mt-8 max-w-lg text-sm leading-relaxed text-[var(--color-text-muted)]">
        For research partnerships, applied conservation planning, or exchange on Bhutan's forest and biodiversity systems, choose the channel that suits your work.
      </p>
    </div>
    <dl
      class="divide-y divide-[var(--color-border-subtle)] border-t border-[var(--color-border-subtle)] px-7 sm:px-10 lg:border-l lg:border-t-0 lg:px-10 lg:py-6"
    >
      {
        SOCIAL.map((s) => (
          <div class="grid grid-cols-[5.5rem_1fr] items-baseline gap-4 py-5">
            <dt class="text-[0.68rem] font-semibold tracking-[0.16em] text-[var(--color-text-muted)] uppercase">
              {s.label}
            </dt>
            <dd class="min-w-0">
              <a
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="link-arrow break-words font-medium text-paper-50 underline-offset-4 hover:text-nvidia-green-300 hover:underline"
              >
                {s.value}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
