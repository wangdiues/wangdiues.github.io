---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import TagPill from '../ui/TagPill.astro';
import { contentSlug } from '../../lib/content-id';
import { caseStudyAssets, caseStudyPreviewAssets } from '../../data/case-study-assets';

const studies = (await getCollection('case-studies')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const panels = studies.map((study) => {
  const slug = contentSlug(study.id);
  const project = study.data.project;
  const preview = caseStudyPreviewAssets[slug];
  const image = project ? caseStudyAssets[project.assetGroup]?.[project.hero.asset] : preview?.image;
  return {
    study,
    href: `/case-studies/${slug}/`,
    image,
    alt: project?.hero.alt ?? preview?.alt,
    objectPosition: preview?.objectPosition,
    initial: study.data.region.replace(/[^A-Za-z]/g, '').charAt(0).toUpperCase() || 'W',
  };
});
---

<section id="work" class="section-space scroll-mt-24">
  <div class="site-shell">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <SectionHeading
        eyebrow="Selected work"
        title="Applied programmes with management-level consequences."
        lede="Field evidence, spatial analysis, and operative outputs — plans, strategies, and monitoring systems designed for use. Hover a title, or tap it to open the full case study."
      />
      <a href="/publications" class="link-arrow text-sm font-semibold text-[var(--color-text-primary)] hover:text-[var(--color-accent)]">Browse all research outputs</a>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,1fr)_26rem] lg:items-start lg:gap-14">
      <ul id="work-list" class="border-t border-[var(--color-text-primary)]">
        {
          panels.map(({ study, href, initial }, index) => (
            <li class="border-b border-[var(--color-text-primary)]" data-active={index === 0 ? 'true' : undefined}>
              <a
                href={href}
                data-work-item
                data-index={index}
                class="group flex items-start justify-between gap-6 py-6 transition-colors"
              >
                <span class="flex min-w-0 flex-1 items-start gap-4">
                  <span
                    class="mt-1 shrink-0 font-heading text-sm tabular-nums text-[var(--color-text-muted)] transition-colors group-hover:text-[var(--color-accent)] [[data-active='true']_&]:text-[var(--color-accent)]"
                    aria-hidden="true"
                  >
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="project-list-title min-w-0 font-heading text-xl leading-snug text-[var(--color-text-muted)] transition-colors group-hover:text-[var(--color-text-primary)] sm:text-2xl [[data-active='true']_&]:text-[var(--color-text-primary)]">
                    {study.data.title}
                  </span>
                  <span class="mt-1 shrink-0 text-[var(--color-text-primary)] opacity-0 transition-opacity group-hover:opacity-100 [[data-active='true']_&]:opacity-100" aria-hidden="true">
                    ↗
                  </span>
                </span>
                <span class="hidden shrink-0 max-w-[14rem] truncate pt-2 text-right text-xs font-medium tracking-wide text-[var(--color-text-muted)] uppercase sm:block">
                  {initial === 'B' ? study.data.region : study.data.region}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="lg:sticky lg:top-28">
        <div
          id="work-preview"
          class="relative aspect-[4/5] overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-text-primary)] bg-[var(--color-bg-raised)]"
        >
          {
            panels.map(({ study, href, image, alt, objectPosition, initial }, index) => (
              <div
                data-panel
                data-index={index}
                aria-hidden={index === 0 ? undefined : 'true'}
                class:list={[
                  'media-dark absolute inset-0 transition-opacity duration-300',
                  index === 0 ? 'opacity-100' : 'pointer-events-none opacity-0',
                ]}
              >
                {image ? (
                  <Image
                    src={image}
                    alt={alt ?? ''}
                    widths={[420, 640, 840]}
                    sizes="(min-width: 1024px) 26rem, 90vw"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    class="h-full w-full object-cover"
                    style={objectPosition ? `object-position: ${objectPosition}` : undefined}
                  />
                ) : (
                  <div
                    aria-hidden="true"
                    class="flex h-full w-full items-center justify-center bg-gradient-to-br from-ink-800 via-ink-900 to-ink-950"
                  >
                    <span class="font-heading text-[10rem] leading-none text-nvidia-green-400/15">{initial}</span>
                  </div>
                )}
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950/92 via-ink-950/35 to-transparent" />
                <div class="absolute inset-x-0 bottom-0 p-6 sm:p-7">
                  <p class="text-[0.65rem] font-semibold tracking-[0.16em] text-nvidia-green-300 uppercase">{study.data.region}</p>
                  <h3 class="project-preview-title mt-3 text-xl leading-snug text-paper-50 sm:text-2xl">{study.data.title}</h3>
                  <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-paper-100/85">{study.data.impact}</p>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {study.data.methods.slice(0, 2).map((method) => <TagPill label={method} />)}
                  </div>
                  <a
                    href={href}
                    data-panel-link
                    tabindex={index === 0 ? undefined : -1}
                    class="link-arrow mt-5 inline-flex items-center text-sm font-medium text-paper-50 hover:text-nvidia-green-300"
                  >
                    Read the case study
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const list = document.getElementById('work-list');
  const items = [...document.querySelectorAll<HTMLAnchorElement>('[data-work-item]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];

  function activate(index: number) {
    for (const item of items) {
      item.closest('li')?.toggleAttribute('data-active', item.dataset.index === String(index));
    }
    for (const panel of panels) {
      const active = panel.dataset.index === String(index);
      panel.classList.toggle('opacity-100', active);
      panel.classList.toggle('opacity-0', !active);
      panel.classList.toggle('pointer-events-none', !active);
      if (active) panel.removeAttribute('aria-hidden');
      else panel.setAttribute('aria-hidden', 'true');
      panel.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => (link.tabIndex = active ? 0 : -1));
    }
  }

  items.forEach((item) => {
    const index = Number(item.dataset.index);
    item.addEventListener('mouseenter', () => activate(index));
    item.addEventListener('focus', () => activate(index));
  });
</script>

<style>
  .project-list-title,
  .project-preview-title {
    overflow-wrap: break-word;
    text-align: start;
    text-wrap: pretty;
  }
</style>
