---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import TagPill from '../ui/TagPill.astro';

const studies = (await getCollection('case-studies')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<section id="work" class="scroll-mt-20 py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading
      eyebrow="Selected work"
      title="Applied programmes with management-level consequences."
      lede="Each case links field evidence, spatial analysis, and an operative output — plans, strategies, and monitoring systems still in use."
    />
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {
        studies.map((study) => (
          <Card href={`/case-studies/${study.id}/`}>
            <p class="text-xs tracking-widest text-moss-400 uppercase">{study.data.region}</p>
            <h3 class="mt-3 text-h3 text-paper-50">{study.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">{study.data.impact}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {study.data.methods.slice(0, 3).map((m) => <TagPill label={m} />)}
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</section>
