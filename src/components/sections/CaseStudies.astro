---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import { contentSlug } from '../../lib/content-id';
import TagPill from '../ui/TagPill.astro';
import { caseStudyAssets } from '../../data/case-study-assets';

const studies = (await getCollection('case-studies')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = studies.find((study) => Boolean(study.data.project));
const remaining = featured ? studies.filter((study) => study.id !== featured.id) : studies;
const featuredProject = featured?.data.project;
const featuredImage = featuredProject
  ? caseStudyAssets[featuredProject.assetGroup]?.[featuredProject.hero.asset]
  : undefined;
---

<section id="work" class="section-space scroll-mt-24">
  <div class="site-shell">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <SectionHeading
        eyebrow="Selected work"
        title="Applied programmes with management-level consequences."
        lede="Field evidence, spatial analysis, and operative outputs — plans, strategies, and monitoring systems designed for use."
      />
      <a href="/publications" class="link-arrow text-sm font-medium text-moss-300 hover:text-moss-400">Browse all research outputs</a>
    </div>

    {
      featured && featuredProject && featuredImage && (
        <a
          href={`/case-studies/${contentSlug(featured.id)}/`}
          class="group mt-14 grid overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)] shadow-card lg:grid-cols-[1.08fr_0.92fr]"
        >
          <div class="relative min-h-72 overflow-hidden lg:min-h-[30rem]">
            <Image
              src={featuredImage}
              alt={featuredProject.hero.alt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 55vw, 100vw"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-950/55 via-transparent to-transparent" aria-hidden="true"></div>
            <span class="absolute left-5 top-5 rounded-full border border-paper-50/20 bg-ink-950/70 px-3 py-1.5 text-[0.65rem] font-semibold tracking-[0.16em] text-paper-50 uppercase backdrop-blur">
              Featured · 2026
            </span>
          </div>
          <div class="flex flex-col justify-between p-7 sm:p-9 lg:p-10">
            <div>
              <p class="text-xs font-semibold tracking-[0.18em] text-moss-300 uppercase">{featured.data.region}</p>
              <h3 class="mt-5 text-balance text-h2 text-paper-50">{featured.data.title}</h3>
              <div class="mt-6 border-l border-moss-400/50 pl-4">
                <p class="text-[0.65rem] font-semibold tracking-[0.16em] text-moss-300 uppercase">Conservation outcome</p>
                <p class="mt-2 text-base leading-relaxed text-[var(--color-text-muted)]">{featured.data.impact}</p>
              </div>
            </div>
            <div class="mt-10">
              <div class="flex flex-wrap gap-2">
                {featured.data.methods.slice(0, 3).map((method) => <TagPill label={method} />)}
              </div>
              <p class="mt-8 flex items-center justify-between border-t border-[var(--color-border-subtle)] pt-5 text-sm font-medium text-paper-50">
                Read the case study
                <span class="text-moss-300 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </p>
            </div>
          </div>
        </a>
      )
    }

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {
        remaining.map((study, index) => (
          <Card href={`/case-studies/${contentSlug(study.id)}/`} class="h-full">
            <div class="flex h-full min-h-72 flex-col">
              <div class="flex items-start justify-between gap-4">
                <p class="text-xs font-semibold tracking-[0.16em] text-moss-300 uppercase">{study.data.region}</p>
                <span class="font-heading text-xl text-[var(--color-text-muted)]" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>
              </div>
              <h3 class="mt-6 text-balance text-h3 text-paper-50">{study.data.title}</h3>
              <div class="mt-5 border-l border-moss-400/40 pl-4">
                <p class="text-[0.62rem] font-semibold tracking-[0.15em] text-moss-300 uppercase">Applied outcome</p>
                <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{study.data.impact}</p>
              </div>
              <div class="mt-auto flex flex-wrap gap-2 border-t border-[var(--color-border-subtle)] pt-5">
                {study.data.methods.slice(0, 3).map((method) => <TagPill label={method} />)}
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</section>
