---
import SectionHeading from '../ui/SectionHeading.astro';

const stages = [
  {
    number: '01',
    title: 'Observe the system',
    description:
      'Frame the management question first, then design field monitoring around species, habitats, people, and the decisions the evidence must support.',
    detail: 'Field ecology · monitoring design · local knowledge',
  },
  {
    number: '02',
    title: 'Test the evidence',
    description:
      'Combine spatial analysis, ecological modelling, and reproducible workflows to distinguish useful signals from assumptions and uncertainty.',
    detail: 'GIS · statistics · modelling · open pipelines',
  },
  {
    number: '03',
    title: 'Move evidence into action',
    description:
      'Translate findings into management plans, monitoring protocols, policy inputs, and community-led conservation that can be used in practice.',
    detail: 'Plans · protocols · governance · stewardship',
  },
];
---

<section id="approach" class="section-space border-y border-[var(--color-border-subtle)]">
  <div class="site-shell">
    <div class="grid gap-8 lg:grid-cols-[1fr_0.72fr] lg:items-end">
      <SectionHeading
        eyebrow="Research approach"
        title="From field signal to management decision."
        lede="Every programme follows one connected line of reasoning: observe carefully, test transparently, and make the result usable."
      />
      <blockquote class="max-w-lg border-l border-[var(--color-accent-gold)] pl-5 text-sm leading-relaxed text-[var(--color-text-muted)] lg:justify-self-end">
        <p class="font-heading text-xl font-medium leading-snug text-[var(--color-text-primary)]">
          “Conservation evidence matters when it reaches the people making decisions.”
        </p>
      </blockquote>
    </div>

    <ol class="mt-12 grid gap-3 md:grid-cols-3 md:gap-4">
      {
        stages.map((stage) => (
          <li class="glass-panel glass-panel-hover group flex min-h-80 flex-col rounded-[var(--radius-lg)] p-6 sm:p-7">
            <div class="flex items-center justify-between gap-4">
              <span class="stat-value text-4xl" aria-hidden="true">
                {stage.number}
              </span>
              <span class="h-px flex-1 bg-[var(--color-border-subtle)]" aria-hidden="true"></span>
            </div>
            <h3 class="mt-10 text-h3 text-[var(--color-text-primary)]">{stage.title}</h3>
            <p class="mt-4 text-sm leading-relaxed text-[var(--color-text-muted)]">{stage.description}</p>
            <p class="mt-auto border-t border-[var(--color-border-subtle)] pt-4 text-[0.65rem] font-semibold tracking-[0.13em] text-[var(--color-accent)] uppercase">
              {stage.detail}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
