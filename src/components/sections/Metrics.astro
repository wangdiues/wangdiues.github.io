---
import { getCollection } from 'astro:content';

const pubs = await getCollection('publications');
const underReview = pubs.filter((p) => p.data.status === 'under-review').length;
const reports = pubs.filter((p) => p.data.status === 'report').length;

const metrics = [
  { value: String(pubs.length), label: 'Publications, plans & strategies' },
  { value: String(underReview), label: 'Manuscripts under review' },
  { value: String(reports), label: 'Management plans & strategies delivered' },
  { value: '100+', label: 'Species documented through camera-trap monitoring' },
];
---

<section class="section-space !py-14 sm:!py-16" aria-label="Research output at a glance">
  <div class="site-shell">
    <div class="mb-9 flex items-center justify-between gap-4 border-b border-[var(--color-border-subtle)] pb-5">
      <p class="eyebrow">Measured impact</p>
      <p class="text-xs text-[var(--color-text-muted)]">Evidence, outputs, and monitoring reach</p>
    </div>
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
    {
      metrics.map((m, index) => (
        <div class="glass-panel relative min-h-44 rounded-[var(--radius-lg)] p-5 sm:p-6">
          <span class="absolute right-4 top-4 text-[0.65rem] tracking-widest text-[var(--color-text-muted)]" aria-hidden="true">0{index + 1}</span>
          <p class="stat-value text-5xl sm:text-6xl">{m.value}</p>
          <p class="mt-5 max-w-48 text-xs leading-relaxed text-[var(--color-text-muted)] sm:text-sm">{m.label}</p>
        </div>
      ))
    }
    </div>
  </div>
</section>
