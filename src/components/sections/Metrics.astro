---
import { getCollection } from 'astro:content';

const pubs = await getCollection('publications');
const underReview = pubs.filter((p) => p.data.status === 'under-review').length;
const reports = pubs.filter((p) => p.data.status === 'report').length;

const metrics = [
  { value: String(pubs.length), label: 'Publications, plans & strategies' },
  { value: String(underReview), label: 'Manuscripts under review' },
  { value: String(reports), label: 'Management plans & strategies delivered' },
  { value: '100+', label: 'Species documented through camera-trap monitoring' },
];
---

<section class="dark-section bg-ink-950 text-paper-50" aria-label="Research output at a glance">
  <div class="site-shell py-14 sm:py-16">
    <div class="mb-9 flex items-center justify-between gap-4 border-b border-paper-50/25 pb-5">
      <p class="text-[0.68rem] font-semibold tracking-[0.2em] uppercase">Measured impact</p>
      <p class="text-xs text-paper-100/70">Evidence, outputs, and monitoring reach</p>
    </div>
    <div class="grid grid-cols-2 border-l border-paper-50/25 lg:grid-cols-4">
    {
      metrics.map((m, index) => (
        <div class="relative min-h-44 border-b border-r border-paper-50/25 p-5 lg:border-b-0 sm:p-6">
          <span class="absolute right-4 top-4 text-[0.65rem] tracking-widest text-paper-100/55" aria-hidden="true">0{index + 1}</span>
          <p class="font-heading text-5xl font-medium tracking-[-0.055em] text-nvidia-green-400 tabular-nums sm:text-6xl">{m.value}</p>
          <p class="mt-5 max-w-48 text-xs leading-relaxed text-paper-100/75 sm:text-sm">{m.label}</p>
        </div>
      ))
    }
    </div>
  </div>
</section>
