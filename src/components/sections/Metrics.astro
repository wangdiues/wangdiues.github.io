---
import { getCollection } from 'astro:content';

const pubs = await getCollection('publications');
const underReview = pubs.filter((p) => p.data.status === 'under-review').length;
const reports = pubs.filter((p) => p.data.status === 'report').length;

const metrics = [
  { value: String(pubs.length), label: 'Publications, plans & strategies' },
  { value: String(underReview), label: 'Manuscripts under review' },
  { value: String(reports), label: 'Management plans & strategies delivered' },
  { value: '100+', label: 'Species documented through camera-trap monitoring' },
];
---

<section class="border-y border-[var(--color-border-subtle)] bg-ink-950/35" aria-label="Research output at a glance">
  <div class="site-shell py-8 sm:py-10">
    <p class="mb-6 text-[0.68rem] font-semibold tracking-[0.2em] text-[var(--color-text-muted)] uppercase">Portfolio at a glance</p>
    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-border-subtle)] lg:grid-cols-4">
    {
      metrics.map((m, index) => (
        <div class="relative min-h-36 bg-ink-900 p-5 sm:p-6">
          <span class="absolute right-4 top-4 text-[0.65rem] tracking-widest text-[var(--color-text-muted)]" aria-hidden="true">0{index + 1}</span>
          <p class="font-heading text-4xl font-semibold tracking-tight text-moss-300 tabular-nums sm:text-5xl">{m.value}</p>
          <p class="mt-3 max-w-44 text-xs leading-relaxed text-[var(--color-text-muted)] sm:text-sm">{m.label}</p>
        </div>
      ))
    }
    </div>
  </div>
</section>
