---
---
<header class="fixed inset-x-0 top-0 z-40 border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-base)]/85 backdrop-blur">
  <nav aria-label="Primary" class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-3 font-heading text-lg font-semibold text-paper-50">
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-moss-400 text-sm font-bold text-ink-900">W</span>
      <span class="hidden sm:inline">Wangdi</span>
    </a>
    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
      class="rounded-md border border-[var(--color-border-subtle)] p-2 md:hidden"
    >
      <span class="sr-only">Toggle navigation</span>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-paper-50"></path>
      </svg>
    </button>
    <ul id="nav-links" class="hidden items-center gap-7 text-sm md:flex">
      <li><a href="/#about" class="text-[var(--color-text-muted)] transition-colors hover:text-moss-400" data-nav-link>About</a></li>
      <li><a href="/#experience" class="text-[var(--color-text-muted)] transition-colors hover:text-moss-400" data-nav-link>Experience</a></li>
      <li><a href="/#work" class="text-[var(--color-text-muted)] transition-colors hover:text-moss-400" data-nav-link>Field work</a></li>
      <li><a href="/#code" class="text-[var(--color-text-muted)] transition-colors hover:text-moss-400" data-nav-link>Code</a></li>
      <li><a href="/publications" class="text-[var(--color-text-muted)] transition-colors hover:text-moss-400" data-nav-link>Publications</a></li>
      <li><a href="/explore" class="text-[var(--color-text-muted)] transition-colors hover:text-moss-400" data-nav-link>Map</a></li>
      <li><a href="/#contact" class="text-[var(--color-text-muted)] transition-colors hover:text-moss-400" data-nav-link>Contact</a></li>
    </ul>
  </nav>
</header>

<style>
  #nav-links a[aria-current='true'] {
    color: var(--color-moss-400);
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  links?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a') && links.classList.contains('md:flex') === false) {
      links.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });

  const sections = ['about', 'experience', 'work', 'code'].map((id) => document.getElementById(id));
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]')];

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const a of navLinks) {
          a.setAttribute(
            'aria-current',
            a.getAttribute('href') === `/#${entry.target.id}` ? 'true' : 'false'
          );
        }
      }
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );

  for (const s of sections) if (s) observer.observe(s);
</script>
