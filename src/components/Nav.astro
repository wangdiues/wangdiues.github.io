---
const items = [
  { href: '/#about', label: 'About', section: 'about' },
  { href: '/#experience', label: 'Experience', section: 'experience' },
  { href: '/#work', label: 'Projects', section: 'work' },
  { href: '/#code', label: 'Code', section: 'code' },
  { href: '/publications', label: 'Publications', route: '/publications' },
  { href: '/explore', label: 'Map', route: '/explore' },
  { href: '/#contact', label: 'Contact', section: 'contact' },
];

const pathname = Astro.url.pathname;
const routeIsCurrent = (route?: string) => route && pathname.startsWith(route);
---

<header class="fixed inset-x-0 top-0 z-40 px-3 pt-3 sm:px-5 sm:pt-4">
  <nav
    aria-label="Primary"
    class="site-shell relative flex h-16 items-center justify-between rounded-full border border-[var(--color-border-subtle)] bg-ink-950/88 px-3 shadow-card backdrop-blur-xl sm:px-5"
  >
    <a href="/" class="group flex min-h-11 items-center gap-3 rounded-full pr-3 font-heading text-lg font-semibold text-paper-50">
      <span class="relative flex h-10 w-10 items-center justify-center rounded-full border border-moss-400/50 bg-moss-400/12 text-sm font-bold text-moss-300">
        W
        <span class="absolute inset-1 rounded-full border border-moss-400/20" aria-hidden="true"></span>
      </span>
      <span class="hidden tracking-tight sm:inline">Wangdi</span>
      <span class="sr-only">— Home</span>
    </a>

    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
      class="flex h-11 w-11 items-center justify-center rounded-full border border-[var(--color-border-subtle)] bg-ink-800 text-paper-50 hover:border-moss-400 hover:text-moss-300 md:hidden"
    >
      <span class="sr-only">Open navigation</span>
      <svg class="nav-open-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
      </svg>
      <svg class="nav-close-icon hidden" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
      </svg>
    </button>

    <ul
      id="nav-links"
      class="absolute left-0 right-0 top-[calc(100%+0.75rem)] hidden flex-col gap-1 rounded-2xl border border-[var(--color-border-subtle)] bg-ink-950/96 p-3 shadow-card backdrop-blur-xl md:static md:flex md:flex-row md:items-center md:gap-1 md:border-0 md:bg-transparent md:p-0 md:shadow-none"
    >
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link
              data-section={item.section}
              aria-current={routeIsCurrent(item.route) ? 'page' : undefined}
              class="flex min-h-11 items-center rounded-full px-4 text-sm font-medium text-[var(--color-text-muted)] hover:bg-paper-50/6 hover:text-paper-50 md:px-3"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  #nav-links a[aria-current='page'],
  #nav-links a[aria-current='location'] {
    background: color-mix(in srgb, var(--color-moss-400) 12%, transparent);
    color: var(--color-moss-300);
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  const openIcon = toggle?.querySelector('.nav-open-icon');
  const closeIcon = toggle?.querySelector('.nav-close-icon');

  function setMenu(open: boolean) {
    links?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.querySelector('.sr-only')?.replaceChildren(document.createTextNode(open ? 'Close navigation' : 'Open navigation'));
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  links?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a') && window.matchMedia('(max-width: 767px)').matches) {
      setMenu(false);
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (toggle?.getAttribute('aria-expanded') === 'true' && !(event.target as HTMLElement).closest('nav')) {
      setMenu(false);
    }
  });

  const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[data-section]')];
  const sections = sectionLinks
    .map((link) => document.getElementById(link.dataset.section ?? ''))
    .filter((section): section is HTMLElement => Boolean(section));

  if (location.pathname === '/' && sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (!visible) return;
        for (const link of sectionLinks) {
          if (link.dataset.section === visible.target.id) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-38% 0px -57% 0px' }
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
