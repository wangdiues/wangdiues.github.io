---
const items = [
  { href: '/#about', label: 'About', section: 'about' },
  { href: '/#work', label: 'Projects', section: 'work' },
  { href: '/#experience', label: 'Experience', section: 'experience' },
  { href: '/#code', label: 'Open Science & Reproducible Research', section: 'code' },
  { href: '/publications', label: 'Publications', route: '/publications' },
  { href: '/explore', label: 'Map', route: '/explore' },
  { href: '/#contact', label: 'Contact', section: 'contact' },
];

const pathname = Astro.url.pathname;
const routeIsCurrent = (route?: string) => route && pathname.startsWith(route);
---

<header id="site-header" class="fixed inset-x-0 top-0 z-40 border-b border-transparent bg-transparent transition-[background-color,border-color,backdrop-filter,box-shadow] duration-300">
  <nav
    aria-label="Primary"
    class="site-shell relative flex h-20 items-center justify-between"
  >
    <a href="/" class="group order-1 flex min-h-11 items-center gap-3 pr-3 font-heading text-lg font-semibold text-[var(--color-text-primary)]">
      <span class="relative flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-text-primary)] text-sm font-bold text-[var(--color-bg-base)]">
        W
      </span>
      <span class="hidden tracking-[-0.03em] sm:inline">Wangdi</span>
      <span class="sr-only">— Home</span>
    </a>

    <div class="order-3 flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-[var(--color-text-primary)] bg-transparent text-[var(--color-text-primary)] hover:bg-[var(--color-accent-solid)] hover:text-[var(--color-on-accent-solid)]"
      >
        <span class="sr-only">Switch to light theme</span>
        <svg class="theme-icon-dark" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M17.2 11.2A7.5 7.5 0 0 1 8.8 2.8a7.5 7.5 0 1 0 8.4 8.4Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          ></path>
        </svg>
        <svg class="theme-icon-light hidden" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="3.5" stroke="currentColor" stroke-width="1.5"></circle>
          <path
            d="M10 2.5v2M10 15.5v2M17.5 10h-2M4.5 10h-2M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4M15.3 15.3l-1.4-1.4M6.1 6.1 4.7 4.7"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>

      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-links"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-[var(--color-text-primary)] bg-[var(--color-text-primary)] text-[var(--color-bg-base)] xl:hidden"
      >
        <span class="sr-only">Open navigation</span>
        <svg class="nav-open-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
        <svg class="nav-close-icon hidden" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <ul
      id="nav-links"
      class="absolute left-0 right-0 top-[calc(100%+0.75rem)] order-2 hidden flex-col gap-1 rounded-[var(--radius-lg)] p-3 xl:static xl:flex xl:flex-row xl:items-center xl:gap-0 xl:p-0"
    >
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link
              data-section={item.section}
              aria-current={routeIsCurrent(item.route) ? 'page' : undefined}
              class:list={[
                'flex min-h-11 items-center rounded-full px-4 text-sm font-medium transition duration-200 xl:px-3',
                item.label === 'Contact'
                  ? 'nav-cta bg-[var(--color-accent-gold-solid)] text-[var(--color-on-accent-gold-solid)] hover:bg-[var(--color-accent-solid)] hover:text-[var(--color-on-accent-solid)]'
                  : 'text-[var(--color-text-primary)]/85 hover:bg-[var(--color-glass-bg-strong)] hover:text-[var(--color-accent-gold)]',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  #site-header.is-scrolled {
    border-color: var(--color-glass-border);
    background: var(--color-glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-glass);
  }

  @media (max-width: 1279px) {
    #nav-links {
      border: 1px solid var(--color-glass-border);
      background: var(--color-glass-bg-strong);
      box-shadow: var(--shadow-glass);
      backdrop-filter: blur(var(--glass-blur));
      -webkit-backdrop-filter: blur(var(--glass-blur));
    }
  }

  #nav-links a[aria-current='page']:not(.nav-cta),
  #nav-links a[aria-current='location']:not(.nav-cta) {
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
    color: var(--color-accent);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const SCROLL_THRESHOLD = 24;

  function syncHeaderScrollState() {
    header?.classList.toggle('is-scrolled', window.scrollY > SCROLL_THRESHOLD);
  }

  syncHeaderScrollState();
  window.addEventListener('scroll', syncHeaderScrollState, { passive: true });

  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  const openIcon = toggle?.querySelector('.nav-open-icon');
  const closeIcon = toggle?.querySelector('.nav-close-icon');

  function setMenu(open: boolean) {
    links?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.querySelector('.sr-only')?.replaceChildren(document.createTextNode(open ? 'Close navigation' : 'Open navigation'));
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  links?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a') && window.matchMedia('(max-width: 1279px)').matches) {
      setMenu(false);
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (toggle?.getAttribute('aria-expanded') === 'true' && !(event.target as HTMLElement).closest('nav')) {
      setMenu(false);
    }
  });

  const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[data-section]')];
  const sections = sectionLinks
    .map((link) => document.getElementById(link.dataset.section ?? ''))
    .filter((section): section is HTMLElement => Boolean(section));

  if (location.pathname === '/' && sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (!visible) return;
        for (const link of sectionLinks) {
          if (link.dataset.section === visible.target.id) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-38% 0px -57% 0px' }
    );
    sections.forEach((section) => observer.observe(section));
  }

  const themeToggle = document.getElementById('theme-toggle');
  const darkIcon = themeToggle?.querySelector('.theme-icon-dark');
  const lightIcon = themeToggle?.querySelector('.theme-icon-light');
  const themeColorMeta = document.querySelector('meta[name="theme-color"]');
  const THEME_COLOR: Record<'dark' | 'light', string> = { dark: '#0a0c0b', light: '#ffffff' };

  function currentTheme(): 'dark' | 'light' {
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  function paintTheme(theme: 'dark' | 'light') {
    document.documentElement.dataset.theme = theme;
    darkIcon?.classList.toggle('hidden', theme === 'light');
    lightIcon?.classList.toggle('hidden', theme === 'dark');
    themeToggle?.querySelector('.sr-only')?.replaceChildren(
      document.createTextNode(theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme')
    );
    themeColorMeta?.setAttribute('content', THEME_COLOR[theme]);
    try {
      localStorage.setItem('theme', theme);
    } catch (_error) {
      // Private browsing or storage disabled — theme just won't persist.
    }
  }

  paintTheme(currentTheme());

  themeToggle?.addEventListener('click', (event) => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const supportsViewTransition = 'startViewTransition' in document;

    if (reduced || !supportsViewTransition) {
      paintTheme(next);
      return;
    }

    const { clientX: x, clientY: y } = event as MouseEvent;
    const endRadius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    const transition = (document as unknown as { startViewTransition: (cb: () => void) => { ready: Promise<void> } }).startViewTransition(
      () => paintTheme(next)
    );

    transition.ready.then(() => {
      document.documentElement.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${endRadius}px at ${x}px ${y}px)`] },
        { duration: 480, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' }
      );
    });
  });
</script>
