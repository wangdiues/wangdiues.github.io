---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Research portfolio of Wangdi Wangdi — biodiversity, climate science, GIS, and forest governance in Bhutan.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-[var(--color-bg-raised)] focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
