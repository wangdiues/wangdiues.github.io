---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProjectGallery from '../../components/case-studies/ProjectGallery.astro';
import Button from '../../components/ui/Button.astro';
import TagPill from '../../components/ui/TagPill.astro';
import { caseStudyAssets } from '../../data/case-study-assets';
import { contentSlug } from '../../lib/content-id';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map((study) => ({
    params: { slug: contentSlug(study.id) },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const project = study.data.project;
const assetGroup = project ? caseStudyAssets[project.assetGroup] : undefined;

if (project && !assetGroup) {
  throw new Error(`Unknown case-study asset group: ${project.assetGroup}`);
}

const heroImage = project ? assetGroup?.[project.hero.asset] : undefined;
if (project && !heroImage) {
  throw new Error(`Missing hero asset: ${project.hero.asset}`);
}

const galleryItems = project
  ? project.gallery.map((item) => {
      const image = assetGroup?.[item.asset];
      if (!image) throw new Error(`Missing gallery asset: ${item.asset}`);
      return { image, alt: item.alt, caption: item.caption };
    })
  : [];
---

<BaseLayout
  title={`${study.data.title} | Wangdi`}
  description={study.data.focus}
  image={heroImage?.src}
>
  <Nav />
  {
    project && heroImage ? (
      <main id="main">
        <header class="site-shell pb-20 pt-36 sm:pt-40">
          <a href="/#work" class="inline-flex min-h-11 items-center text-sm font-medium text-ember-300 underline-offset-4 hover:underline">
            ← All field work
          </a>

          <div class="mt-8 overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)] shadow-card">
            <div class="aspect-[16/9] overflow-hidden sm:aspect-[2/1]">
              <Image
                src={heroImage}
                alt={project.hero.alt}
                widths={[720, 1080, 1440, 1920]}
                sizes="(min-width: 1024px) 1024px, 100vw"
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
            </div>
          </div>

          <div class="mt-10 max-w-4xl">
            <a
              href={project.award.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-full border border-ember-400/45 bg-ember-400/10 px-4 py-2 text-xs font-semibold tracking-[0.14em] text-ember-300 uppercase hover:bg-ember-400/15"
            >
              {project.award.name} {project.award.year}
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
            <p class="mt-7 text-xs tracking-widest text-ember-400 uppercase">{study.data.region}</p>
            <h1 class="text-balance mt-4 text-h1 tracking-[-0.03em] text-paper-50">{study.data.title}</h1>
            <p class="mt-5 max-w-3xl text-lead text-[var(--color-text-muted)]">{study.data.focus}</p>
          </div>

          <dl class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-border-subtle)] sm:grid-cols-2 lg:grid-cols-4">
            <div class="bg-[var(--color-bg-raised)] p-5">
              <dt class="text-xs tracking-widest text-ember-400 uppercase">Year</dt>
              <dd class="mt-2 text-paper-50">{project.year}</dd>
            </div>
            <div class="bg-[var(--color-bg-raised)] p-5">
              <dt class="text-xs tracking-widest text-ember-400 uppercase">Role</dt>
              <dd class="mt-2 text-paper-50">{project.role}</dd>
            </div>
            <div class="bg-[var(--color-bg-raised)] p-5 sm:col-span-2">
              <dt class="text-xs tracking-widest text-ember-400 uppercase">Category</dt>
              <dd class="mt-2 text-sm leading-relaxed text-paper-50">{project.categories.join(' / ')}</dd>
            </div>
          </dl>

          <div class="mt-8 flex flex-wrap gap-3">
            <Button href={project.document.href} download>
              {project.document.label}
            </Button>
            <Button href={project.award.url} variant="secondary" external>
              View CLP recognition <span aria-hidden="true">↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </Button>
          </div>
        </header>

        <div class="border-y border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)]/40">
          <div class="site-shell grid gap-10 py-20 lg:grid-cols-[1.5fr_1fr] lg:gap-16">
            <section aria-labelledby="project-overview-title">
              <p class="text-sm font-medium tracking-widest text-ember-400 uppercase">Conservation challenge</p>
              <h2 id="project-overview-title" class="mt-2 text-h2 text-paper-50">Project Overview</h2>
              <p class="mt-6 text-lg leading-relaxed text-[var(--color-text-muted)]">{project.summary}</p>
            </section>

            <aside class="surface-panel rounded-[var(--radius-lg)] p-6" aria-labelledby="project-team-title">
              <h2 id="project-team-title" class="text-sm font-medium tracking-wider text-paper-50 uppercase">Project team</h2>
              <ul class="mt-5 space-y-3 text-[var(--color-text-muted)]">
                {project.team.map((member) => <li>{member}</li>)}
              </ul>
              <p class="mt-6 border-t border-[var(--color-border-subtle)] pt-5 text-sm text-[var(--color-text-muted)]">
                Team Leader: <span class="text-paper-50">{project.team[0]}</span>
              </p>
            </aside>
          </div>
        </div>

        <section aria-labelledby="research-approach-title" class="site-shell py-20">
          <p class="text-sm font-medium tracking-widest text-ember-400 uppercase">Integrated field science</p>
          <h2 id="research-approach-title" class="mt-2 text-h2 text-paper-50">Research Approach</h2>
          <div class="mt-10 grid gap-6 lg:grid-cols-3">
            {project.approaches.map((approach, index) => (
              <article class="surface-panel rounded-[var(--radius-lg)] p-6">
                <p class="text-xs font-medium tracking-widest text-ember-400">0{index + 1}</p>
                <h3 class="mt-4 text-h3 text-paper-50">{approach.title}</h3>
                <p class="mt-4 text-sm leading-relaxed text-[var(--color-text-muted)]">{approach.description}</p>
                <ul class="mt-6 space-y-3 border-t border-[var(--color-border-subtle)] pt-5 text-sm text-paper-50">
                  {approach.points.map((point) => (
                    <li class="flex gap-3"><span class="text-ember-400" aria-hidden="true">•</span><span>{point}</span></li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="community-title" class="border-y border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)]/40">
          <div class="site-shell grid gap-10 py-20 lg:grid-cols-[1.2fr_1fr] lg:items-start lg:gap-16">
            <div>
              <p class="text-sm font-medium tracking-widest text-ember-400 uppercase">Local stewardship</p>
              <h2 id="community-title" class="mt-2 text-h2 text-paper-50">Community Conservation</h2>
              <p class="mt-6 text-lg leading-relaxed text-[var(--color-text-muted)]">{project.community.description}</p>
            </div>
            <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
              {project.community.points.map((point) => (
                <li class="rounded-[var(--radius-md)] border border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)] px-5 py-4 text-paper-50">
                  <span class="mr-3 text-ember-400" aria-hidden="true">✓</span>{point}
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section aria-labelledby="outputs-title" class="site-shell py-20">
          <p class="text-sm font-medium tracking-widest text-ember-400 uppercase">Planned deliverables</p>
          <h2 id="outputs-title" class="mt-2 text-h2 text-paper-50">Expected Outputs</h2>
          <div class="mt-10 grid gap-4 sm:grid-cols-2">
            {project.outputs.map((output, index) => (
              <article class="surface-panel flex gap-5 rounded-[var(--radius-lg)] p-6">
                <span class="font-heading text-2xl text-ember-400" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="text-lg text-paper-50">{output}</h3>
              </article>
            ))}
          </div>
        </section>

        <ProjectGallery items={galleryItems} />

        <section aria-labelledby="recognition-title" class="site-shell py-20">
          <div class="dark-section rounded-[var(--radius-lg)] bg-ink-950 p-8 sm:p-10">
            <p class="text-sm font-medium tracking-widest text-ember-300 uppercase">External recognition</p>
            <h2 id="recognition-title" class="mt-3 text-h2 text-paper-50">{project.award.organization}</h2>
            <p class="mt-4 text-lg text-[var(--color-text-muted)]">{project.award.name} {project.award.year}</p>
            <div class="mt-7 flex flex-wrap gap-3">
              <Button href={project.award.url} external>
                View official project page <span aria-hidden="true">↗</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </Button>
              <Button href={project.document.href} variant="secondary" download>
                {project.document.label}
              </Button>
            </div>
          </div>
        </section>
      </main>
    ) : (
      <main id="main" class="reading-shell pb-24 pt-36 sm:pt-40">
        <a href="/#work" class="inline-flex min-h-11 items-center text-sm font-medium text-ember-300 underline-offset-4 hover:underline">← All field work</a>
        <p class="mt-8 text-xs tracking-widest text-ember-400 uppercase">{study.data.region}</p>
        <h1 class="mt-3 text-h1 text-paper-50">{study.data.title}</h1>
        <p class="mt-4 text-lead text-[var(--color-text-muted)]">{study.data.focus}</p>

        <div class="surface-panel mt-10 rounded-[var(--radius-lg)] p-6">
          <h2 class="text-sm font-medium tracking-wider text-paper-50 uppercase">Conservation impact</h2>
          <p class="mt-2 text-[var(--color-text-muted)]">{study.data.impact}</p>
        </div>

        <div class="prose mt-10 max-w-none text-[var(--color-text-muted)] [&_p]:mb-4">
          <Content />
        </div>

        <div class="mt-10">
          <h2 class="mb-3 text-sm font-medium tracking-wider text-paper-50 uppercase">Methods</h2>
          <div class="flex flex-wrap gap-2">
            {study.data.methods.map((method) => <TagPill label={method} />)}
          </div>
        </div>
      </main>
    )
  }
  <Footer />
</BaseLayout>
