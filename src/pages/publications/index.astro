---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const statusLabel = {
  published: 'Published',
  'under-review': 'Under review',
  'in-preparation': 'In preparation',
  report: 'Report',
} as const;
---

<BaseLayout
  title="Publications | Wangdi Wangdi"
  description="Peer-reviewed publications, manuscripts under review, management plans, and conservation strategies by Wangdi Wangdi."
>
  <Nav />
  <main id="main" class="mx-auto max-w-4xl px-6 pt-28 pb-20">
    <SectionHeading
      eyebrow="Research outputs"
      title="Publications, plans, and strategies."
      lede="Peer-reviewed work, manuscripts under review, and institutional planning documents spanning wildlife ecology, forest ecosystems, climate vulnerability, and governance."
    />
    <ul class="mt-12 space-y-5">
      {
        publications.map((pub) => (
          <li class="rounded-lg border border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)] p-6 transition-colors hover:border-moss-400">
            <div class="flex flex-wrap items-center gap-3">
              <StatusBadge status={pub.data.status} />
              <span class="text-xs text-[var(--color-text-muted)]">
                {statusLabel[pub.data.status] !== 'Published' && `${statusLabel[pub.data.status]} · `}
                {pub.data.venue} · {pub.data.year}
              </span>
            </div>
            <h2 class="mt-3 font-heading text-xl leading-snug text-paper-50">{pub.data.title}</h2>
            <p class="mt-1 text-sm text-[var(--color-text-muted)]">{pub.data.authors}</p>
            <div class="mt-4 flex flex-wrap gap-4 text-sm">
              {pub.data.doi && (
                <a href={`https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener noreferrer" class="text-moss-400 underline-offset-4 hover:underline">
                  DOI: {pub.data.doi}
                </a>
              )}
              {pub.data.pdf && (
                <a href={pub.data.pdf} class="text-moss-400 underline-offset-4 hover:underline">
                  PDF
                </a>
              )}
              {!pub.data.pdf && !pub.data.doi && pub.data.status === 'report' && (
                <span class="text-[var(--color-text-muted)]">Institutional document — available from DoFPS on request</span>
              )}
              {!pub.data.pdf && !pub.data.doi && pub.data.status === 'in-preparation' && (
                <span class="text-[var(--color-text-muted)]">Manuscript in preparation</span>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</BaseLayout>
