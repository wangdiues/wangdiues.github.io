---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import { contentSlug } from '../../lib/content-id';

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const filters = [
  { key: 'all', label: 'All' },
  { key: 'published', label: 'Published' },
  { key: 'under-review', label: 'Under review' },
  { key: 'in-preparation', label: 'In preparation' },
  { key: 'report', label: 'Plans & strategies' },
];

const counts = Object.fromEntries(
  filters.map((f) => [
    f.key,
    f.key === 'all'
      ? publications.length
      : publications.filter((p) => p.data.status === f.key).length,
  ])
);
---

<BaseLayout
  title="Publications | Wangdi Wangdi"
  description="Peer-reviewed publications, manuscripts under review, management plans, and conservation strategies by Wangdi Wangdi."
>
  <Nav />
  <main id="main" class="mx-auto max-w-4xl px-6 pt-28 pb-20">
    <SectionHeading
      eyebrow="Research outputs"
      title="Publications, plans, and strategies."
      lede="Peer-reviewed work, manuscripts under review, and institutional planning documents spanning wildlife ecology, forest ecosystems, climate vulnerability, and governance. Filter by publication status — the under-review pipeline is where current fieldwork becomes papers."
    />

    <div
      id="pub-filter"
      class="mt-10 flex flex-wrap gap-2"
      role="group"
      aria-label="Filter publications by status"
    >
      {
        filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class:list={[
              'rounded-full border px-4 py-1.5 text-sm transition-colors',
              'border-[var(--color-border-subtle)] text-[var(--color-text-muted)] hover:border-moss-400 hover:text-moss-400',
            ]}
          >
            {f.label} <span class="tabular-nums opacity-70">{counts[f.key]}</span>
          </button>
        ))
      }
    </div>

    <ul id="pub-list" class="mt-8 space-y-5">
      {
        publications.map((pub) => (
          <li
            data-status={pub.data.status}
            class="rounded-lg border border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)] p-6 transition-colors hover:border-moss-400"
          >
            <div class="flex flex-wrap items-center gap-3">
              <StatusBadge status={pub.data.status} />
              <span class="text-xs text-[var(--color-text-muted)]">
                {pub.data.venue} · {pub.data.year}
              </span>
            </div>
            <h2 class="mt-3 font-heading text-xl leading-snug text-paper-50">
              <a href={`/publications/${contentSlug(pub.id)}/`} class="underline-offset-4 hover:underline">
                {pub.data.title}
              </a>
            </h2>
            <p class="mt-1 text-sm text-[var(--color-text-muted)]">{pub.data.authors}</p>
            <div class="mt-4 flex flex-wrap gap-4 text-sm">
              {pub.data.doi && (
                <a
                  href={`https://doi.org/${pub.data.doi}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-moss-400 underline-offset-4 hover:underline"
                >
                  DOI: {pub.data.doi}
                </a>
              )}
              {pub.data.pdf && (
                <a href={pub.data.pdf} class="text-moss-400 underline-offset-4 hover:underline">
                  PDF
                </a>
              )}
              {!pub.data.pdf && !pub.data.doi && pub.data.status === 'report' && (
                <span class="text-[var(--color-text-muted)]">Institutional document — available from DoFPS on request</span>
              )}
              {!pub.data.pdf && !pub.data.doi && pub.data.status === 'in-preparation' && (
                <span class="text-[var(--color-text-muted)]">Manuscript in preparation</span>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm text-[var(--color-text-muted)]">
      Follow new outputs via <a href="/rss.xml" class="text-moss-400 underline-offset-4 hover:underline">RSS</a>.
    </p>
  </main>
  <Footer />
</BaseLayout>

<style>
  #pub-list li[data-hidden] {
    display: none;
  }
</style>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#pub-filter button')];
  const items = [...document.querySelectorAll<HTMLLIElement>('#pub-list li[data-status]')];
  const valid = new Set(buttons.map((b) => b.dataset.filter));

  function apply(filter: string) {
    for (const b of buttons) {
      b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
      b.classList.toggle('border-moss-400', b.dataset.filter === filter);
      b.classList.toggle('text-moss-400', b.dataset.filter === filter);
    }
    for (const li of items) {
      if (filter === 'all' || li.dataset.status === filter) li.removeAttribute('data-hidden');
      else li.setAttribute('data-hidden', '');
    }
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const filter = b.dataset.filter ?? 'all';
      apply(filter);
      const url = new URL(location);
      if (filter === 'all') url.searchParams.delete('status');
      else url.searchParams.set('status', filter);
      history.replaceState(null, '', url);
    })
  );

  const requested = new URLSearchParams(location.search).get('status') ?? '';
  apply(valid.has(requested) ? requested : 'all');
</script>
