---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import { contentSlug } from '../../lib/content-id';

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// A manuscript genuinely moves in-preparation -> under-review -> published, so the
// filter is drawn as that progression rather than a flat pill row. Institutional
// plans and strategies are a separate track, not a stage of the journal pipeline.
const pipeline = [
  { key: 'in-preparation', label: 'In preparation' },
  { key: 'under-review', label: 'Under review' },
  { key: 'published', label: 'Published' },
];

const tracks = [
  { key: 'all', label: 'All outputs' },
  { key: 'report', label: 'Plans & strategies' },
];

const filters = [...tracks, ...pipeline];

const counts = Object.fromEntries(
  filters.map((f) => [
    f.key,
    f.key === 'all'
      ? publications.length
      : publications.filter((p) => p.data.status === f.key).length,
  ])
);
---

<BaseLayout
  title="Publications | Wangdi"
  description="Peer-reviewed publications, manuscripts under review, management plans, and conservation strategies by Wangdi."
>
  <Nav />
  <main id="main" class="site-shell pb-24 pt-36 sm:pt-40">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <SectionHeading
        eyebrow="Research outputs"
        title="Publications, plans, and strategies."
        lede="Peer-reviewed work, manuscripts under review, and institutional planning documents spanning wildlife ecology, forest ecosystems, climate vulnerability, and governance."
      />
      <p class="font-heading text-5xl text-ember-300 tabular-nums" aria-label={`${publications.length} total outputs`}>
        {String(publications.length).padStart(2, '0')}
      </p>
    </div>

    <div id="pub-filter" class="surface-panel mt-12 rounded-[var(--radius-lg)] p-5 sm:p-6" role="group" aria-label="Filter publications by status">
      <p class="text-xs font-medium tracking-wider text-[var(--color-text-muted)] uppercase">
        Manuscript pipeline
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-2">
        {
          pipeline.map((f, i) => (
            <Fragment>
              <button
                type="button"
                data-filter={f.key}
                aria-pressed="false"
                class="min-h-11 rounded-full border border-[var(--color-border-subtle)] bg-transparent px-4 py-2 text-sm text-[var(--color-text-muted)] hover:border-[var(--color-text-primary)] hover:text-[var(--color-text-primary)]"
              >
                {f.label} <span class="tabular-nums opacity-70">{counts[f.key]}</span>
              </button>
              {i < pipeline.length - 1 && (
                <span class="select-none text-[var(--color-text-muted)]" aria-hidden="true">
                  &rarr;
                </span>
              )}
            </Fragment>
          ))
        }
      </div>
      <div class="mt-5 flex flex-wrap gap-2 border-t border-[var(--color-border-subtle)] pt-5">
        {
          tracks.map((f) => (
            <button
              type="button"
              data-filter={f.key}
              aria-pressed={f.key === 'all' ? 'true' : 'false'}
              class="min-h-11 rounded-full border border-[var(--color-border-subtle)] bg-transparent px-4 py-2 text-sm text-[var(--color-text-muted)] hover:border-[var(--color-text-primary)] hover:text-[var(--color-text-primary)]"
            >
              {f.label} <span class="tabular-nums opacity-70">{counts[f.key]}</span>
            </button>
          ))
        }
      </div>
    </div>

    <ul id="pub-list" class="mt-12 border-b border-[var(--color-border-subtle)]">
      {
        publications.map((pub, index) => (
          <li
            data-status={pub.data.status}
            class="group grid gap-5 border-t border-[var(--color-border-subtle)] py-7 md:grid-cols-[9.5rem_1fr] md:gap-8"
          >
            <div>
              <p class="mb-3 text-[0.65rem] font-semibold tracking-[0.16em] text-[var(--color-text-muted)]" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
              <StatusBadge status={pub.data.status} />
              <p class="mt-3 text-xs text-[var(--color-text-muted)]">{pub.data.year}</p>
            </div>
            <div>
              <p class="text-xs font-medium tracking-wide text-ember-300">{pub.data.venue}</p>
              <h2 class="mt-3 max-w-3xl font-heading text-2xl leading-snug text-paper-50">
                <a href={`/publications/${contentSlug(pub.id)}/`} class="underline-offset-4 group-hover:text-ember-300 hover:underline">
                  {pub.data.title}
                </a>
              </h2>
              <p class="mt-2 text-sm text-[var(--color-text-muted)]">{pub.data.authors}</p>
              <div class="mt-5 flex flex-wrap gap-4 text-sm">
                {pub.data.doi && (
                  <a href={`https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener noreferrer" class="link-arrow text-ember-300 underline-offset-4 hover:underline">
                    DOI
                  </a>
                )}
                {pub.data.pdf && <a href={pub.data.pdf} class="text-ember-300 underline-offset-4 hover:underline">Download PDF</a>}
                {!pub.data.pdf && !pub.data.doi && pub.data.status === 'report' && <span class="text-[var(--color-text-muted)]">Institutional document — available from DoFPS on request</span>}
                {!pub.data.pdf && !pub.data.doi && pub.data.status === 'in-preparation' && <span class="text-[var(--color-text-muted)]">Manuscript in preparation</span>}
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm text-[var(--color-text-muted)]">
      Follow new outputs via <a href="/rss.xml" class="text-ember-400 underline-offset-4 hover:underline">RSS</a>.
    </p>
  </main>
  <Footer />
</BaseLayout>

<style>
  #pub-list li[data-hidden] {
    display: none;
  }
</style>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#pub-filter button')];
  const items = [...document.querySelectorAll<HTMLLIElement>('#pub-list li[data-status]')];
  const valid = new Set(buttons.map((b) => b.dataset.filter));

  function apply(filter: string) {
    for (const b of buttons) {
      b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
      b.classList.toggle('border-ember-400', b.dataset.filter === filter);
      b.classList.toggle('text-ember-400', b.dataset.filter === filter);
    }
    for (const li of items) {
      if (filter === 'all' || li.dataset.status === filter) li.removeAttribute('data-hidden');
      else li.setAttribute('data-hidden', '');
    }
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const filter = b.dataset.filter ?? 'all';
      apply(filter);
      const url = new URL(location);
      if (filter === 'all') url.searchParams.delete('status');
      else url.searchParams.set('status', filter);
      history.replaceState(null, '', url);
    })
  );

  const requested = new URLSearchParams(location.search).get('status') ?? '';
  apply(valid.has(requested) ? requested : 'all');
</script>
