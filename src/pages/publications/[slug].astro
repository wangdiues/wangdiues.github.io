---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import TagPill from '../../components/ui/TagPill.astro';
import { formatCitation, splitAuthors, relatedCaseStudies } from '../../lib/citation';
import { contentSlug } from '../../lib/content-id';
import { SITE_VIDEOS } from '../../data/site-video-backgrounds';

const bg = SITE_VIDEOS['valley-vista'];

export async function getStaticPaths() {
  const publications = await getCollection('publications');
  return publications.map((pub) => ({
    params: { slug: contentSlug(pub.id) },
    props: { pub },
  }));
}

const { pub } = Astro.props;
const { Content } = await render(pub);
const citation = formatCitation(pub);
const titleLength = pub.data.title.length;
const titleScale = titleLength > 150 ? 'long' : titleLength > 95 ? 'medium' : 'standard';

const allStudies = await getCollection('case-studies');
const related = relatedCaseStudies(pub, allStudies);

const statusLabel = {
  published: 'Published',
  'under-review': 'Under review',
  'in-preparation': 'In preparation',
  report: 'Report',
} as const;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: pub.data.title,
  author: splitAuthors(pub.data.authors).map((name) => ({ '@type': 'Person', name })),
  datePublished: String(pub.data.year),
  isPartOf: pub.data.venue,
  url: pub.data.doi ? `https://doi.org/${pub.data.doi}` : `https://wangdiues.github.io/publications/${contentSlug(pub.id)}/`,
  identifier: pub.data.doi,
});
---

<BaseLayout
  title={`${pub.data.title} | Wangdi`}
  description={pub.body?.slice(0, 155)}
  background="video"
  videoSrc={bg.mp4}
  videoWebm={bg.webm}
  videoPoster={bg.poster}
  videoObjectPosition={bg.objectPosition}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonld} />
  </Fragment>
  <Nav />
  <main id="main" class="reading-shell pb-24 pt-36 sm:pt-40">
    <a href="/publications" class="inline-flex min-h-11 items-center text-sm font-medium text-nvidia-green-300 underline-offset-4 hover:underline">← All publications</a>

    <header class="mt-8 border-b border-[var(--color-border-subtle)] pb-10">
      <div class="flex flex-wrap items-center gap-3">
        <StatusBadge status={pub.data.status} />
        <span class="text-xs tracking-wide text-[var(--color-text-muted)]">{statusLabel[pub.data.status]} · {pub.data.year}</span>
      </div>
      <h1 class="publication-title" data-title-scale={titleScale}>{pub.data.title}</h1>
      <p class="mt-5 text-lg text-[var(--color-text-muted)]">{pub.data.authors}</p>
      <p class="mt-2 text-sm text-nvidia-green-300 italic">{pub.data.venue}</p>
      {pub.data.cover && (
        <img
          src={pub.data.cover}
          alt={`Cover of ${pub.data.title}`}
          loading="eager"
          width="452"
          height="603"
          class="mt-8 aspect-[3/4] w-40 rounded-[var(--radius-md)] border border-[var(--color-border-subtle)] object-cover sm:w-48"
        />
      )}
    </header>

    <div class="prose mt-10 max-w-none text-[var(--color-text-muted)] [&_p]:mb-5 [&_p]:text-[1.05rem] [&_p]:leading-8">
      <Content />
    </div>

    <div class="mt-10 flex flex-wrap gap-3 text-sm">
      {
        pub.data.doi && (
          <a
            href={`https://doi.org/${pub.data.doi}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center rounded-full border border-nvidia-green-400 bg-nvidia-green-400 px-5 py-2 font-medium text-ink-950 hover:-translate-y-0.5 hover:bg-nvidia-green-300"
          >
            View at publisher (DOI)
          </a>
        )
      }
      {
        pub.data.pdf && (
          <a
            href={pub.data.pdf}
            class="inline-flex min-h-11 items-center rounded-full border border-[var(--color-border-subtle)] bg-paper-50/[0.03] px-5 py-2 font-medium text-paper-50 hover:-translate-y-0.5 hover:border-nvidia-green-400 hover:text-nvidia-green-300"
          >
            Download PDF
          </a>
        )
      }
    </div>

    {
      pub.data.rightsNote && (
        <p class="mt-8 rounded-[var(--radius-md)] border border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)] p-5 text-sm text-[var(--color-text-muted)]">
          {pub.data.rightsNote}
        </p>
      )
    }

    <div class="surface-panel mt-10 rounded-[var(--radius-lg)] p-6">
      <h2 class="text-xs font-medium tracking-wider text-paper-50 uppercase">Citation</h2>
      <p id="citation-text" class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{citation}</p>
      <button
        id="copy-citation"
        type="button"
        class="mt-4 min-h-11 text-sm font-medium text-nvidia-green-300 underline-offset-4 hover:underline"
        data-citation={citation}
      >
        Copy citation
      </button>
    </div>

    {
      pub.data.tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {pub.data.tags.map((t) => (
            <TagPill label={t} />
          ))}
        </div>
      )
    }

    {
      related.length > 0 && (
        <div class="mt-12 border-t border-[var(--color-border-subtle)] pt-8">
          <h2 class="mb-4 text-sm font-medium tracking-wider text-paper-50 uppercase">Related field work</h2>
          <ul class="space-y-3">
            {related.map((study) => (
              <li>
                <a
                  href={`/case-studies/${contentSlug(study.id)}/`}
                  class="text-nvidia-green-400 underline-offset-4 hover:underline"
                >
                  {study.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </main>
  <Footer />
</BaseLayout>

<script>
  document.getElementById('copy-citation')?.addEventListener('click', async function () {
    const text = this.dataset.citation ?? '';
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    const original = this.textContent;
    this.textContent = 'Copied ✓';
    setTimeout(() => (this.textContent = original), 2000);
  });
</script>

<style>
  .publication-title {
    margin-top: 1.25rem;
    max-inline-size: 19ch;
    color: var(--color-text-primary);
    font-size: clamp(2.4rem, 1.55rem + 3.5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
    text-align: start;
    text-wrap: balance;
  }

  .publication-title[data-title-scale='medium'] {
    max-inline-size: 24ch;
    font-size: clamp(2.1rem, 1.45rem + 2.9vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  .publication-title[data-title-scale='long'] {
    max-inline-size: 28ch;
    font-size: clamp(1.875rem, 1.4rem + 2.2vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
</style>
