---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SOCIAL, FIELD_METHODS, PLATFORMS, REPOSITORIES, GITHUB_PROFILE } from '../config';
import { SITE_VIDEOS } from '../data/site-video-backgrounds';

const bg = SITE_VIDEOS['forest-mist'];

const jobs = (await getCollection('experience')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const published = publications.filter((p) => p.data.status === 'published');
const underReview = publications.filter((p) => p.data.status === 'under-review');
const inPrep = publications.filter((p) => p.data.status === 'in-preparation');
const reports = publications.filter((p) => p.data.status === 'report');

const group = (label: string, items: typeof publications) => ({
  label,
  items,
});
const groups = [
  group('Published', published),
  group('Manuscripts under review', underReview),
  group('In preparation', inPrep),
  group('Management plans & strategies', reports),
];

const technicalExpertise = [
  {
    label: 'Geospatial & Remote Sensing',
    detail: 'QGIS, ArcGIS, Google Earth Engine, and Python with GeoPandas and ArcPy.',
  },
  {
    label: 'Data Analysis & Modelling',
    detail: 'R, Python, SPSS, machine learning, multivariate analysis, and environmental data visualisation.',
  },
  {
    label: 'Ecological & Field Methods',
    detail:
      'Species distribution modelling, camera-trap data analysis, occupancy modelling, climate modelling, forest inventory, environmental monitoring, acoustic monitoring, and AI-assisted species identification.',
  },
  {
    label: 'Professional Strengths',
    detail:
      'Project management, budget administration, team leadership, stakeholder engagement, scientific and grant writing, environmental impact assessment, conservation planning, and climate adaptation.',
  },
];

const professionalDevelopment = [
  {
    label: 'Conservation, Biodiversity & Climate Change',
    detail:
      'Advanced professional training through ICIMOD, UNDP, and IUCN in climate-change adaptation, ecosystem restoration, collaborative conservation planning, biodiversity assessment, and IUCN Red List assessment methodologies.',
  },
  {
    label: 'Remote Sensing, GIS & Earth Observation',
    detail:
      'Professional training through NASA ARSET, EO College, and ISRO/NRSC in satellite remote sensing, GIS-based spatial planning, environmental monitoring, forest-fire detection, active-fire monitoring, and burnt-area mapping.',
  },
  {
    label: 'Data Science, Geospatial Analytics & Modelling',
    detail:
      'Applied training in R, Python, QGIS, Google Earth Engine, statistical modelling, machine learning, spatial analysis, and environmental data visualisation for forestry, biodiversity, and natural-resource management.',
  },
  {
    label: 'Ecological & Conservation Analytics',
    detail:
      'Specialised training in species distribution modelling, camera-trap analysis, biodiversity monitoring, ecological data management, and spatial conservation planning.',
  },
  {
    label: 'Emerging Technologies & Digital Applications',
    detail:
      'Training in drone operations for emergency response, full-stack web development, digital data-management systems, Google Workspace administration, and technology-enabled environmental monitoring.',
  },
  {
    label: 'Sustainability, Economics & Management',
    detail:
      'Professional development in environmental, social and governance principles, production-cost estimation, resource planning, and sustainability-oriented decision-making.',
  },
  {
    label: 'AI & Developer Tools',
    detail:
      'Anthropic Certificates of Completion in Claude 101 (3 May 2026), Claude Code 101 (3 May 2026), and Claude Code in Action (7 May 2026), covering generative AI, AI-assisted coding, and developer workflows.',
  },
];
---

<BaseLayout
  title="Curriculum Vitae | Wangdi"
  description="Curriculum vitae of Wangdi — forestry, biodiversity research, GIS, and forest governance."
  background="video"
  videoSrc={bg.mp4}
  videoWebm={bg.webm}
  videoPoster={bg.poster}
  videoObjectPosition={bg.objectPosition}
>
  <Nav />
  <main id="main" class="reading-shell cv pb-24 pt-36 sm:pt-40">
    <header class="border-b border-[var(--color-border-subtle)] pb-8">
      <div class="mb-6 flex items-center gap-4">
        <span class="h-px w-9 bg-nvidia-green-400" aria-hidden="true"></span>
        <p class="text-xs font-semibold tracking-[0.2em] text-nvidia-green-300 uppercase">Curriculum vitae</p>
      </div>
      <h1 class="font-heading text-h1 font-semibold tracking-[-0.04em] text-paper-50">Wangdi</h1>
      <p class="mt-2 text-lg text-[var(--color-text-muted)]">Senior Forestry Officer · Conservation Researcher</p>
      <p class="mt-1 text-sm text-[var(--color-text-muted)]">
        Department of Forests &amp; Park Services, Bhutan ·
        <a href={`https://orcid.org/0009-0007-7726-1742`} class="text-nvidia-green-400 underline-offset-4 hover:underline">ORCID 0009-0007-7726-1742</a>
      </p>
      <p class="mt-1 text-sm">
        {
          SOCIAL.map((s, i) => (
            <>
              <a href={s.href} class="text-nvidia-green-400 underline-offset-4 hover:underline">{s.value}</a>
              {i < SOCIAL.length - 1 && ' · '}
            </>
          ))
        }
      </p>
    </header>

    <section class="cv-section">
      <h2>Honours &amp; Awards</h2>
      <ul>
        <li>
          Conservation Leadership Programme (CLP) Future Conservationist Team Award — 2026 · Team
          Leader, <a href="https://www.conservationleadershipprogramme.org/project/bhutans-first-gps-ai-study-great-hornbills/" target="_blank" rel="noopener noreferrer"><em>Connected Skies</em></a>
        </li>
        <li>Meritorious Promotion, Royal Civil Service Commission — effective 1 January 2026</li>
        <li>SAF-Madanjeet Singh Scholarship — merit-based full scholarship (2017–2021)</li>
      </ul>
    </section>

    <section class="cv-section">
      <h2>Education</h2>
      <p class="font-semibold">Bachelor of Science (Honours) in Forestry — First Class</p>
      <p class="text-sm opacity-80">College of Natural Resources, Royal University of Bhutan · July 2017 – June 2021 · Overall grade 79%</p>
      <ul>
        <li>
          Thesis: Analysis of Physical and Chemical Properties of Natural Salt Licks and Determination of Animal Presence
        </li>
        <li>
          Methods: ecological field surveys, wildlife sign assessment, camera-trap monitoring, soil and mineral analysis, biodiversity data collection, statistical analysis, scientific writing, and interpretation of species–environment relationships.
        </li>
      </ul>
    </section>

    <section class="cv-section">
      <h2>Technical Expertise</h2>
      <dl class="cv-detail-list">
        {
          technicalExpertise.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv-section">
      <h2>Professional Development &amp; Certifications</h2>
      <dl class="cv-detail-list">
        {
          professionalDevelopment.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv-section">
      <h2>Selected conservation project</h2>
      <p class="font-semibold">
        <a href="https://www.conservationleadershipprogramme.org/project/bhutans-first-gps-ai-study-great-hornbills/" target="_blank" rel="noopener noreferrer">Connected Skies: Bhutan's First GPS-AI Study Empowering Communities to Protect Great Hornbills</a>
      </p>
      <p class="text-sm opacity-80">Team Leader · 2026 CLP Future Conservationist Team Award</p>
      <ul>
        <li>
          Leading a multidisciplinary project combining GPS-GSM tracking, AI-assisted bioacoustic monitoring, field ecology, and community engagement for Great Hornbill conservation in south-central Bhutan.
        </li>
        <li>
          Studying movement routes, home ranges, seasonal habitat use, nesting and feeding areas, and connectivity bottlenecks to inform evidence-based conservation action.
        </li>
      </ul>
    </section>

    <section class="cv-section">
      <h2>Experience</h2>
      {
        jobs.map((job) => (
          <div class="mb-5">
            <p class="font-semibold">{job.data.title} — {job.data.company}</p>
            <p class="text-sm opacity-80">
              {job.data.location} · {job.data.range}
            </p>
            <ul>
              {(job.body ?? '')
                .split('\n')
                .filter((line) => line.trim().startsWith('- '))
                .map((line) => (
                  <li>{line.trim().slice(2)}</li>
                ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="cv-section">
      <h2>Selected outputs</h2>
      {
        groups.map(({ label, items }) => (
          <>
            <h3>{label}</h3>
            <ul class="pub-list">
              {items.map((p) => (
                <li>
                  {p.data.authors} ({p.data.year}). {p.data.title}.{' '}
                  <em>{p.data.venue}</em>.
                  {p.data.doi && (
                    <span> https://doi.org/{p.data.doi}</span>
                  )}
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </section>

    <section class="cv-section">
      <h2>Methods &amp; platforms</h2>
      <p class="text-sm">{FIELD_METHODS.join(' · ')}</p>
      <p class="text-sm">{PLATFORMS.join(' · ')}</p>
    </section>

    <section class="cv-section">
      <h2>Code &amp; data repositories</h2>
      <p class="mb-3 text-sm opacity-80">
        Reproducible analysis pipelines on
        <a href={GITHUB_PROFILE} target="_blank" rel="noopener noreferrer">GitHub (@wangdiues)</a>:
      </p>
      <ul>
        {
          REPOSITORIES.map((repo) => (
            <li>
              <a href={`${GITHUB_PROFILE}/${repo.name}`} target="_blank" rel="noopener noreferrer">
                {repo.name}
              </a>{' '}
              — {repo.description}
              {repo.language && ` (${repo.language})`}
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="no-print mt-12 flex flex-wrap gap-3 border-t border-[var(--color-border-subtle)] pt-8">
      <button
        type="button"
        onclick="window.print()"
        class="min-h-11 rounded-full border border-nvidia-green-400 bg-nvidia-green-400 px-6 py-2.5 font-medium text-ink-950 hover:bg-nvidia-green-300"
      >
        Print / Save as PDF
      </button>
      <a
        href="/Wangdi_CV_2026.pdf"
        class="inline-flex min-h-11 items-center rounded-full border border-[var(--color-border-subtle)] px-6 py-2.5 text-sm font-medium text-paper-50 underline-offset-4 hover:border-nvidia-green-400 hover:text-nvidia-green-300"
      >
        Download CV (PDF)
      </a>
      <a
        href="/resume/"
        class="inline-flex min-h-11 items-center rounded-full border border-[var(--color-border-subtle)] px-6 py-2.5 text-sm font-medium text-paper-50 underline-offset-4 hover:border-nvidia-green-400 hover:text-nvidia-green-300"
      >
        View designed resume
      </a>
      <a href="/" class="inline-flex min-h-11 items-center text-sm text-nvidia-green-300 underline-offset-4 hover:underline">← Back to portfolio</a>
    </footer>
  </main>
  <Footer />
</BaseLayout>

<style>
  @media print {
    :global(body) {
      background: #fff !important;
    }
    :global(.video-background),
    :global(body > header),
    :global(body > footer),
    .no-print {
      display: none !important;
    }
    .cv,
    .cv :global(*) {
      color: #111 !important;
      background: transparent !important;
    }
    .cv-section {
      break-inside: avoid;
    }
    .pub-list li {
      margin-bottom: 0.4rem;
    }
  }

  .cv-section {
    margin-top: 3.25rem;
    padding-top: 0.25rem;
  }
  .cv-section h2 {
    font-family: var(--font-heading);
    font-size: var(--type-h3);
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }
  .cv-section h3 {
    font-size: var(--type-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 1rem 0 0.5rem;
  }
  .pub-list {
    list-style: none;
    padding: 0;
  }
  ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .cv-detail-list {
    border-top: 1px solid var(--color-border-subtle);
  }
  .cv-detail-list > div {
    display: grid;
    gap: 0.35rem;
    border-bottom: 1px solid var(--color-border-subtle);
    padding: 1rem 0;
  }
  .cv-detail-list dt {
    color: var(--color-text-primary);
    font-weight: 600;
  }
  .cv-detail-list dd {
    color: var(--color-text-muted);
    line-height: 1.7;
  }
  @media (min-width: 640px) {
    .cv-detail-list > div {
      grid-template-columns: minmax(11rem, 0.72fr) minmax(0, 1.28fr);
      gap: 1.5rem;
    }
  }
</style>
