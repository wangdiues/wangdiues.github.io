---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page not found | Wangdi">
  <main id="main" class="site-shell flex min-h-screen flex-col items-center justify-center py-20 text-center">
    <div class="mb-6 flex items-center gap-4 text-xs font-semibold tracking-[0.2em] text-ember-300 uppercase">
      <span class="h-px w-9 bg-ember-400" aria-hidden="true"></span>
      Error 404
      <span class="h-px w-9 bg-ember-400" aria-hidden="true"></span>
    </div>
    <p class="font-heading text-[clamp(6rem,25vw,14rem)] font-semibold leading-none tracking-[-0.07em] text-ink-700" aria-hidden="true">404</p>
    <h1 class="-mt-4 text-balance text-h2 text-paper-50 sm:-mt-8">This trail does not continue.</h1>
    <p class="mt-5 max-w-xl text-[var(--color-text-muted)]">
      The portfolio was recently rebuilt — try the home page, publications index, or search the sitemap.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <Button href="/">Home</Button>
      <Button href="/publications" variant="secondary">Publications</Button>
    </div>
  </main>
</BaseLayout>
