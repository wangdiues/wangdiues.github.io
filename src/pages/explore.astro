---
import { LAYERS } from '../data/geo/layers';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import TagPill from '../components/ui/TagPill.astro';

const layersJson = JSON.stringify(LAYERS);
---

<BaseLayout
  title="Research Map | Wangdi"
  description="Interactive research map — protected-area connectivity, habitat modelling outputs, and survey footprints, published under DoFPS data-disclosure rules."
>
  <Nav />
  <main id="main" class="site-shell pb-24 pt-36 sm:pt-40">
    <SectionHeading
      eyebrow="GIS explorer"
      title="Research map."
      lede="Spatial context for the research on this site. Occurrence-level data is never published; sensitive layers appear only as aggregated extents after written clearance."
    />
    <div class="mt-8 flex flex-wrap gap-2">
      <TagPill label="Protected areas & corridors: full resolution (public)" />
      <TagPill label="SDM surfaces: model outputs only" />
      <TagPill label="Occurrences: aggregated or withheld" />
    </div>

    <p id="map-status" class="sr-only" aria-live="polite"></p>
    <div class="mt-12 grid gap-6 lg:grid-cols-[300px_1fr]">
      <aside class="surface-panel h-fit rounded-[var(--radius-lg)] p-5 lg:sticky lg:top-28">
        <h2 class="mb-4 text-xs font-semibold tracking-[0.16em] text-paper-50 uppercase">Layers</h2>
        <fieldset id="layer-panel" class="space-y-2" data-layers={layersJson}>
          <legend class="sr-only">Toggle map layers</legend>
          {
            LAYERS.length === 0 && (
              <p class="rounded-[var(--radius-md)] border border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)] p-4 text-sm text-[var(--color-text-muted)]">
                No layers published yet. Data preparation is under DoFPS disclosure review —
                cleared layers will appear here with full source notes.
              </p>
            )
          }
        </fieldset>
        <details class="mt-6 rounded-[var(--radius-md)] border border-[var(--color-border-subtle)] bg-[var(--color-bg-raised)] p-4">
          <summary class="min-h-11 text-sm font-medium text-ember-300">View layer data as table</summary>
          <div id="layer-tables" class="mt-4 space-y-6 text-sm">
            <p class="text-[var(--color-text-muted)]">
              Every approved map attribute is available in paginated tables for screen readers
              and keyboard-only use.
            </p>
          </div>
        </details>
      </aside>
      <div class="relative min-h-[34rem] overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-ink-800 shadow-card">
        <div id="map" class="absolute inset-0" role="application" aria-label="Interactive research map of Bhutan"></div>
        <noscript>
          <p class="p-6 text-sm text-[var(--color-text-muted)]">
            The interactive map requires JavaScript. Approved layer attributes remain available
            as text tables above.
          </p>
        </noscript>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { displayValue, pageBounds, waitForMapLoad } from '../lib/map-runtime';

  type PublicField = { key: string; label: string };
  type Layer = {
    id: string;
    label: string;
    file: string;
    description: string;
    attribution: string;
    geometry: 'polygon' | 'line' | 'point';
    publicFields: PublicField[];
  };
  type Feature = {
    type: 'Feature';
    properties: Record<string, unknown>;
    geometry: { type: string; coordinates: unknown };
  };
  type FeatureCollection = { type: 'FeatureCollection'; features: Feature[] };
  type LoadedLayer = { layer: Layer; geojson: FeatureCollection; checkbox: HTMLInputElement };

  const PAGE_SIZE = 50;

  function text<Tag extends keyof HTMLElementTagNameMap>(tag: Tag, value: string, className?: string) {
    const element = document.createElement(tag);
    element.textContent = value;
    if (className) element.className = className;
    return element;
  }

  function renderTable(layer: Layer, geojson: FeatureCollection) {
    const host = document.getElementById('layer-tables');
    if (!host) return;

    const section = document.createElement('section');
    section.setAttribute('aria-labelledby', `${layer.id}-table-title`);
    const heading = text('h3', layer.label, 'font-medium text-paper-50');
    heading.id = `${layer.id}-table-title`;
    section.append(
      heading,
      text('p', layer.description, 'mt-1 text-xs text-[var(--color-text-muted)]'),
      text('p', `Source: ${layer.attribution}`, 'mt-1 text-xs text-[var(--color-text-muted)]')
    );

    if (geojson.features.length === 0) {
      section.append(text('p', 'This approved layer contains no features.', 'mt-3 text-[var(--color-text-muted)]'));
      host.append(section);
      return;
    }

    const wrapper = document.createElement('div');
    wrapper.className = 'mt-3 overflow-x-auto';
    const table = document.createElement('table');
    table.className = 'w-full border-collapse text-left';
    const caption = text('caption', `${layer.label}: ${geojson.features.length} feature records`, 'sr-only');
    const head = document.createElement('thead');
    const headerRow = document.createElement('tr');
    for (const field of layer.publicFields) {
      const cell = text('th', field.label, 'border-b border-black/20 px-2 py-1 font-medium text-paper-50');
      cell.scope = 'col';
      headerRow.append(cell);
    }
    head.append(headerRow);
    const body = document.createElement('tbody');
    table.append(caption, head, body);
    wrapper.append(table);
    section.append(wrapper);

    const controls = document.createElement('div');
    controls.className = 'mt-3 flex items-center justify-between gap-3';
    const count = text('p', '', 'text-xs text-[var(--color-text-muted)]');
    const buttons = document.createElement('div');
    buttons.className = 'flex gap-2';
    const previous = text('button', 'Previous', 'min-h-11 rounded border border-[var(--color-border-subtle)] px-3 py-2 disabled:cursor-not-allowed disabled:opacity-40');
    previous.type = 'button';
    const next = text('button', 'Next', 'min-h-11 rounded border border-[var(--color-border-subtle)] px-3 py-2 disabled:cursor-not-allowed disabled:opacity-40');
    next.type = 'button';
    buttons.append(previous, next);
    controls.append(count, buttons);
    section.append(controls);

    let page = 0;
    const renderPage = () => {
      body.replaceChildren();
      const { start, end } = pageBounds(page, geojson.features.length, PAGE_SIZE);
      for (const feature of geojson.features.slice(start, end)) {
        const row = document.createElement('tr');
        for (const field of layer.publicFields) {
          row.append(text('td', displayValue(feature.properties?.[field.key]), 'border-b border-black/10 px-2 py-1 align-top'));
        }
        body.append(row);
      }
      count.textContent = `Showing ${start + 1}–${end} of ${geojson.features.length}`;
      previous.disabled = page === 0;
      next.disabled = end >= geojson.features.length;
    };
    previous.addEventListener('click', () => {
      page -= 1;
      renderPage();
    });
    next.addEventListener('click', () => {
      page += 1;
      renderPage();
    });
    renderPage();
    host.append(section);
  }

  function layerStyleIds(layer: Layer) {
    if (layer.geometry === 'polygon') return [`${layer.id}-fill`, `${layer.id}-line`];
    return [`${layer.id}-${layer.geometry}`];
  }

  const init = async () => {
    const panel = document.getElementById('layer-panel');
    const status = document.getElementById('map-status');
    const layers: Layer[] = JSON.parse(panel?.dataset.layers ?? '[]');
    const loaded: LoadedLayer[] = [];

    status!.textContent = layers.length === 0 ? 'No map layers are published.' : 'Loading approved map layers.';

    await Promise.all(
      layers.map(async (layer) => {
        const label = document.createElement('label');
        label.className = 'flex min-h-11 cursor-pointer items-center gap-2 text-sm';
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.checked = true;
        checkbox.disabled = true;
        label.append(checkbox, document.createTextNode(layer.label));
        panel?.append(label);

        try {
          const response = await fetch(`/geo/${encodeURIComponent(layer.file)}`);
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const geojson = (await response.json()) as FeatureCollection;
          if (geojson.type !== 'FeatureCollection' || !Array.isArray(geojson.features)) {
            throw new Error('invalid FeatureCollection');
          }
          renderTable(layer, geojson);
          loaded.push({ layer, geojson, checkbox });
        } catch (error) {
          label.append(text('span', 'Unavailable', 'text-xs text-red-300'));
          status!.textContent = `${layer.label} failed to load: ${error instanceof Error ? error.message : 'unknown error'}`;
        }
      })
    );

    try {
      const maplibre = await import('maplibre-gl');
      await import('maplibre-gl/dist/maplibre-gl.css');
      const map = new maplibre.Map({
        container: 'map',
        style: 'https://demotiles.maplibre.org/style.json',
        center: [90.4, 27.4],
        zoom: 5.6,
      });
      map.addControl(new maplibre.NavigationControl({ showCompass: false }));
      await waitForMapLoad(map);

      for (const { layer, geojson, checkbox } of loaded) {
        map.addSource(layer.id, { type: 'geojson', data: geojson });
        if (layer.geometry === 'polygon') {
          map.addLayer({
            id: `${layer.id}-fill`,
            type: 'fill',
            source: layer.id,
            paint: { 'fill-color': '#c8ef2b', 'fill-opacity': 0.25 },
          });
          map.addLayer({
            id: `${layer.id}-line`,
            type: 'line',
            source: layer.id,
            paint: { 'line-color': '#536600', 'line-width': 1.5 },
          });
        } else if (layer.geometry === 'line') {
          map.addLayer({
            id: `${layer.id}-line`,
            type: 'line',
            source: layer.id,
            paint: { 'line-color': '#536600', 'line-width': 2 },
          });
        } else {
          map.addLayer({
            id: `${layer.id}-point`,
            type: 'circle',
            source: layer.id,
            paint: { 'circle-color': '#536600', 'circle-radius': 5 },
          });
        }
        checkbox.disabled = false;
        checkbox.addEventListener('change', () => {
          const visibility = checkbox.checked ? 'visible' : 'none';
          for (const id of layerStyleIds(layer)) map.setLayoutProperty(id, 'visibility', visibility);
        });
      }
      status!.textContent = loaded.length === 0 ? 'Base map loaded; no data layers are published.' : `${loaded.length} approved map layer(s) loaded.`;
    } catch (error) {
      const mapElement = document.getElementById('map');
      if (mapElement) {
        mapElement.replaceChildren(
          text('p', 'Map failed to load. Approved layer tables remain available.', 'p-6 text-sm text-[var(--color-text-muted)]')
        );
      }
      status!.textContent = `Interactive map failed to load: ${error instanceof Error ? error.message : 'unknown error'}`;
    }
  };

  void init();
</script>
